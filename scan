local alive, paused, dirty = true, false, true
local logs, connections, watched, charConnections = {}, {}, {}, {}
local started = os.clock()
local rateTime, rateCount, dropped = started, 0, 0

local function connect(signal, callback, list)
    local connection = signal:Connect(callback)
    local bucket = list or connections
    bucket[#bucket + 1] = connection
    return connection
end

local function disconnect(list)
    for _, connection in ipairs(list) do
        connection:Disconnect()
    end
end

local function path(object)
    local ok, result = pcall(function()
        return object:GetFullName()
    end)
    return ok and result or "<removed>"
end

local function describe(v, depth, seen)
    local kind = typeof(v)

    if kind == "Instance" then
        return path(v)
    end

    if kind == "string" then
        return string.format("%q", v:sub(1, 160))
            .. (#v > 160 and "..." or "")
    end

    if kind == "table" then
        if seen[v] then return "<cycle>" end
        if depth >= 2 then return "{...}" end

        seen[v] = true
        local parts, count = {}, 0

        for k, item in next, v do
            count += 1

            if count > 8 then
                parts[#parts + 1] = "..."
                break
            end

            parts[#parts + 1] = describe(k, depth + 1, seen)
                .. "=" .. describe(item, depth + 1, seen)
        end

        seen[v] = nil
        return "{" .. table.concat(parts, ", ") .. "}"
    end

    return tostring(v):sub(1, 180)
end

local function log(kind, target, ...)
    if not alive or paused then return end

    local now = os.clock()

    if now - rateTime >= 1 then
        rateTime, rateCount = now, 0
    end

    if rateCount >= 100 then
        dropped += 1
        dirty = true
        return
    end

    rateCount += 1

    local args = {}

    for i = 1, math.min(select("#", ...), 8) do
        local ok, result = pcall(describe, select(i, ...), 0, {})
        args[#args + 1] = ok and result or "<unavailable>"
    end

    if select("#", ...) > 8 then
        args[#args + 1] = "..."
    end

    local name = typeof(target) == "Instance"
        and path(target) or tostring(target)

    logs[#logs + 1] = string.format(
        "[%.2fs] %s | %s%s",
        now - started,
        kind,
        name,
        #args > 0 and " | " .. table.concat(args, ", ") or ""
    ):sub(1, 1600)

    if #logs > 500 then
        table.remove(logs, 1)
    end

    dirty = true
end

local function make(class, parent, properties)
    local object = Instance.new(class)

    for k, v in pairs(properties) do
        object[k] = v
    end

    if object:IsA("TextLabel")
        or object:IsA("TextButton")
        or object:IsA("TextBox") then
        object.AutoLocalize = false
    end

    object.Parent = parent
    return object
end

