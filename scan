local function main()
    local ui = criarUI()

    local qtd = scanTudo()
    setStatus(ui, "🔍 " .. qtd .. " payloads encontrados.", Color3.fromRGB(100, 200, 255))
    ui.counterLabel.Text = "📦 " .. qtd .. " | ✅ 0 | ❌ 0"

    limparLista(ui)
    for _, p in ipairs(payloads) do
        local cor = p.rig == "R15" and Color3.fromRGB(40, 60, 110)
                 or p.rig == "R6"  and Color3.fromRGB(70, 40, 40)
                 or Color3.fromRGB(45, 45, 65)
        addItem(ui, "📦 [" .. p.rig .. "] " .. p.nome, cor)
    end

    ui.fireBtn.MouseButton1Click:Connect(function()
        task.spawn(function() dispararTodos(ui) end)
    end)

    ui.scanBtn.MouseButton1Click:Connect(function()
        local q = scanTudo()
        setStatus(ui, "🔍 Reescaneado: " .. q .. " payloads.", Color3.fromRGB(100, 200, 255))
        ui.counterLabel.Text = "📦 " .. q .. " | ✅ 0 | ❌ 0"
        limparLista(ui)
        for _, p in ipairs(payloads) do
            local cor = p.rig == "R15" and Color3.fromRGB(40, 60, 110)
                     or p.rig == "R6"  and Color3.fromRGB(70, 40, 40)
                     or Color3.fromRGB(45, 45, 65)
            addItem(ui, "📦 [" .. p.rig .. "] " .. p.nome, cor)
        end
    end)

    ui.stopBtn.MouseButton1Click:Connect(function()
        pararSolicitado = true
    end)

    if CONFIG.AUTO_SCAN then
        task.spawn(function()
            while ui.gui and ui.gui.Parent do
                task.wait(CONFIG.SCAN_INTERVALO)
                if not disparando then
                    local q = scanTudo()
                    setStatus(ui, "🔄 Auto-scan: " .. q .. " payloads.", Color3.fromRGB(150, 150, 255))
                end
            end
        end)
    end

    LocalPlayer.CharacterAdded:Connect(function(char)
        task.wait(1)
        local rig = isR15(char) and "R15" or "R6"
        setStatus(ui, "🎯 Rig: " .. rig .. " | reescaneando...", Color3.fromRGB(200, 220, 255))
        scanTudo()
    end)
end

main()
