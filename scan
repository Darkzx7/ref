task.spawn(function()
    local ok, objects = pcall(function()
        return game:GetDescendants()
    end)

    if not ok then
        monitor:Add("MONITOR", "Initial scan unavailable", objects)
        return
    end

    for index, object in ipairs(objects) do
        if not monitor.alive then return end

        watch(object)

        if index % 400 == 0 then
            task.wait()
        end
    end

    monitor:Add("MONITOR", "Initial scan complete")
end)
