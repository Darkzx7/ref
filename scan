-- Standalone module reader: no remote calls, hooks or gameplay changes.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Http = game:GetService("HttpService")
local UIS = game:GetService("UserInputService")
local player = Players.LocalPlayer
assert(player, "Run on the client")
local pg = player:WaitForChild("PlayerGui")
local previous = pg:FindFirstChild("SnookerModuleReader")
if previous then previous:Destroy() end
local gui = Instance.new("ScreenGui")
gui.Name = "SnookerModuleReader"
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
gui.Parent = pg
local connections, workers = {}, {}
local alive, busy = true, false
local output = {version="Snooker module reader 1", place=game.PlaceId, modules={}}
local function connect(signal, fn)
    local c=signal:Connect(fn); connections[#connections+1]=c; return c
end
local function create(class, props, parent)
    local o=Instance.new(class)
    for k,v in pairs(props) do o[k]=v end
    o.Parent=parent
    return o
end
local function round(o)
    create("UICorner",{CornerRadius=UDim.new(0,7)},o)
end
local frame=create("Frame",{Size=UDim2.fromOffset(308,164),Position=UDim2.new(.5,-154,.3,0),BackgroundColor3=Color3.fromRGB(23,24,27),BorderSizePixel=0},gui)
round(frame)
local title=create("TextLabel",{Text="snooker modules",Font=Enum.Font.GothamMedium,TextSize=14,TextColor3=Color3.fromRGB(235,235,235),BackgroundTransparency=1,TextXAlignment=Enum.TextXAlignment.Left,Position=UDim2.fromOffset(12,0),Size=UDim2.fromOffset(210,36),Active=true},frame)
local body=create("Frame",{BackgroundTransparency=1,Position=UDim2.fromOffset(12,40),Size=UDim2.fromOffset(284,112)},frame)
local status=create("TextLabel",{Text="ready — read once, then save",TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,TextColor3=Color3.fromRGB(185,188,196),Font=Enum.Font.Gotham,TextSize=12,BackgroundTransparency=1,Size=UDim2.fromOffset(284,62)},body)
local function button(text,x,width,parent,y)
    local b=create("TextButton",{Text=text,Size=UDim2.fromOffset(width,32),Position=UDim2.fromOffset(x,y or 74),BackgroundColor3=Color3.fromRGB(42,44,49),TextColor3=Color3.fromRGB(235,235,235),Font=Enum.Font.GothamMedium,TextSize=12,BorderSizePixel=0},parent or body)
    round(b); return b
end
local read=button("read",0,88)
local copy=button("copy",98,88)
local save=button("save",196,88)
local mini=button("-",230,30,frame,2)
local close=button("x",268,30,frame,2)
local function report(message) if alive then status.Text=message end end
local function resolve(parts)
    local at=RS
    for _,name in ipairs(parts) do at=at:FindFirstChild(name); if not at then return end end
    return at
end
local function inspect(module, path)
    local entry={path=path,found=module~=nil}
    if not module then entry.error="Module not found"; return entry end
    entry.class=module.ClassName
    local ok, source=pcall(function() return module.Source end)
    if ok and type(source)=="string" and #source>0 then
        entry.source=source; entry.sourceKind="Source property"; return entry
    end
    if type(decompile)~="function" then
        entry.error="Executor does not provide decompile; Source property unavailable"
        return entry
    end
    -- Decompilation does not require or initialize the module.
    local done, completed, result=false,false,nil
    local worker=task.spawn(function()
        local success, value=pcall(decompile,module)
        completed,result=success,value
        done=true
    end)
    workers[worker]=true
    local deadline=os.clock()+12
    while alive and not done and os.clock()<deadline do task.wait(.1) end
    workers[worker]=nil
    if not done then
        pcall(task.cancel,worker)
        entry.error=alive and "Decompile timed out" or "Reader closed"
    elseif completed and type(result)=="string" and #result>0 then
        entry.source=result; entry.sourceKind="Executor decompilation; may be incomplete"
    else
        entry.error=tostring(result or "Empty decompiler result")
    end
    return entry
end
connect(read.Activated,function()
    if busy then return end
    busy=true
    output.modules={}
    output.exported=os.date("!%Y-%m-%dT%H:%M:%SZ")
    task.spawn(function()
        local targets={{"Configuration","Snooker"},{"Modules","SnookerPhysics"},{"Client","Snooker"}}
        local count=0
        for _,parts in ipairs(targets) do
            if not alive then return end
            local path="ReplicatedStorage."..table.concat(parts,".")
            report("reading "..parts[1].."."..parts[2].."...")
            local ok, entry=pcall(inspect,resolve(parts),path)
            if not ok then entry={path=path,error=tostring(entry)} end
            output.modules[#output.modules+1]=entry
            if entry.source then count+=1 end
        end
        busy=false
        report(tostring(count).."/3 source results — save or copy. Decompiler output still needs review.")
    end)
end)
local function export()
    return Http:JSONEncode(output)
end
connect(copy.Activated,function()
    if busy then report("wait until reading finishes"); return end
    if #output.modules==0 then report("click read first"); return end
    local clipboard=setclipboard or toclipboard
    if type(clipboard)~="function" then report("clipboard unavailable — use save"); return end
    local ok,err=pcall(function() clipboard(export()) end)
    report(ok and "copied" or tostring(err))
end)
connect(save.Activated,function()
    if busy then report("wait until reading finishes"); return end
    if #output.modules==0 then report("click read first"); return end
    if type(writefile)~="function" then report("writefile unavailable — use copy"); return end
    local folder=""
    if type(makefolder)=="function" and type(isfolder)=="function" then
        local ok=pcall(function()
            for _,dir in ipairs({"True Ref","True Ref/Scans","True Ref/Scans/snooker"}) do
                if not isfolder(dir) then makefolder(dir) end
            end
            if isfolder("True Ref/Scans/snooker") then folder="True Ref/Scans/snooker/" end
        end)
        if not ok then folder="" end
    end
    local name=folder.."snooker_modules_"..os.date("%Y%m%d_%H%M%S")..".json"
    local ok,err=pcall(function() writefile(name,export()) end)
    report(ok and ("saved: "..name) or tostring(err))
end)
local small=false
connect(mini.Activated,function()
    small=not small; body.Visible=not small
    frame.Size=UDim2.fromOffset(308,small and 36 or 164)
    mini.Text=small and "+" or "-"
end)
local drag, start, position
connect(title.InputBegan,function(input)
    if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
        drag=input; start=input.Position; position=frame.Position
    end
end)
connect(UIS.InputChanged,function(input)
    if not drag then return end
    if drag.UserInputType==Enum.UserInputType.Touch and input~=drag then return end
    if drag.UserInputType~=Enum.UserInputType.Touch and input.UserInputType~=Enum.UserInputType.MouseMovement then return end
    local delta=input.Position-start
    frame.Position=UDim2.new(position.X.Scale,position.X.Offset+delta.X,position.Y.Scale,position.Y.Offset+delta.Y)
end)
connect(UIS.InputEnded,function(input) if drag==input then drag=nil end end)
local function cleanup()
    if not alive then return end
    alive=false
    for worker in pairs(workers) do pcall(task.cancel,worker) end
    for _,c in ipairs(connections) do c:Disconnect() end
end
connect(gui.Destroying,cleanup)
connect(close.Activated,function() cleanup(); gui:Destroy() end)
