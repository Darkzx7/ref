-- Mouse/touch dragging

local drag, origin, initial

connect(title.InputBegan, function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
        drag = i
        origin = i.Position
        initial = frame.Position
    end
end)

connect(Input.InputChanged, function(i)
    if not drag then return end

    if i == drag or (
        drag.UserInputType == Enum.UserInputType.MouseButton1
        and i.UserInputType == Enum.UserInputType.MouseMovement
    ) then
        local d = i.Position - origin

        frame.Position = UDim2.new(
            initial.X.Scale,
            initial.X.Offset + d.X,
            initial.Y.Scale,
            initial.Y.Offset + d.Y
        )
    end
end)

connect(Input.InputEnded, function(i)
    if i == drag then
        drag = nil
    end
end)

-- Menu observations

local function describe(obj)
    local entry = {
        path = path(obj),
        class = obj.ClassName,
        attributes = attributes(obj),
    }

    if obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox") then
        entry.text = obj.Text
    end

    if obj:IsA("GuiButton") then
        entry.active = obj.Active
    end

    local parent = obj.Parent

    if parent then
        entry.parentAttributes = attributes(parent)
    end

    return entry
end

local function changed(key, data, force)
    local encoded = Http:JSONEncode(data)

    if force or previous[key] ~= encoded then
        previous[key] = encoded
        log(key, data)
    end
end

local function poll(force)
    for _, name in ipairs(names) do
        local root = pg:FindFirstChild(name)
        local entries = {}

        if root then
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("GuiButton") and not watched[obj] then
                    watched[obj] = true

                    connect(obj.Activated, function()
                        if not alive then return end

                        local data = describe(obj)
                        data.playerPosition = position()
                        data.context = {}

                        if obj.Parent then
                            for _, child in ipairs(
                                obj.Parent:GetDescendants()
                            ) do
                                if visible(child) and (
                                    child:IsA("TextLabel")
                                    or child:IsA("TextButton")
                                ) then
                                    data.context[#data.context + 1] = {
                                        path = path(child),
                                        text = child.Text,
                                    }
                                end
                            end
                        end

                        log("CLICK", data)
                    end)
                end

                if visible(obj) and (
                    obj:IsA("GuiButton")
                    or obj:IsA("TextLabel")
                    or obj:IsA("TextBox")
                ) then
                    entries[#entries + 1] = describe(obj)
                end
            end
        end

        table.sort(entries, function(a, b)
            return a.path < b.path
        end)

        changed("UI:" .. name, entries, force)
    end

    local tools = {}

    local containers = {
        backpack = player:FindFirstChildOfClass("Backpack"),
        character = player.Character,
    }

    for _, container in pairs(containers) do
        for _, obj in ipairs(container:GetChildren()) do
            if obj:IsA("Tool") then
                tools[#tools + 1] = {
                    name = obj.Name,
                    equipped = container == player.Character,
                }
            end
        end
    end

    table.sort(tools, function(a, b)
        return a.name .. tostring(a.equipped)
            < b.name .. tostring(b.equipped)
    end)

    changed("TOOLS", tools, force)
end

-- Kitchen stations and merchant

local function world()
    local npcs = workspace:FindFirstChild("NPCS")
    local merchant = npcs and npcs:FindFirstChild("Merchant")

    local map = workspace:FindFirstChild("Map")
    local house = map and map:FindFirstChild("House")
    house = house and house:FindFirstChild("House")

    return house and house:FindFirstChild("Chicken"), merchant
end

local function promptData(p)
    local part = p:FindFirstAncestorWhichIsA("BasePart")

    return {
        path = path(p),
        action = p.ActionText,
        object = p.ObjectText,
        enabled = p.Enabled,
        hold = p.HoldDuration,
        distance = p.MaxActivationDistance,
        position = part and vector(part.Position) or nil,
        attributes = attributes(p),
    }
end

local function captureWorld(force)
    local kitchen, merchant = world()

    local data = {
        prompts = {},
        playerPosition = force and position() or nil,
    }

    if merchant and merchant:IsA("Model") then
        data.merchantPosition = vector(
            merchant:GetPivot().Position
        )
    end

    for _, scope in pairs({
        kitchen = kitchen,
        merchant = merchant,
    }) do
        for _, obj in ipairs(scope:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                data.prompts[#data.prompts + 1] = promptData(obj)
            end
        end
    end

    table.sort(data.prompts, function(a, b)
        return a.path < b.path
    end)

    changed("STATIONS", data, force)
end

connect(Prompts.PromptTriggered, function(prompt, who)
    if who and who ~= player then return end

    local kitchen, merchant = world()

    if (kitchen and prompt:IsDescendantOf(kitchen))
        or (merchant and prompt:IsDescendantOf(merchant)) then
        local data = promptData(prompt)
        data.playerPosition = position()
        log("PROMPT", data)
    end
end)

-- Export

local function fullCapture()
    poll(true)
    captureWorld(true)
end

local function export()
    fullCapture()

    return Http:JSONEncode({
        collector = "Kitchen collector v1",
        place = game.PlaceId,
        exported = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        discarded = dropped,
        note = "Passive UI, tools and prompts. Outgoing remotes are not captured.",
        records = records,
    })
end

connect(capture.Activated, function()
    fullCapture()
    status.Text = "Current menus and stations captured."
end)

connect(copy.Activated, function()
    local text = export()

    local fn = type(setclipboard) == "function" and setclipboard
        or (type(toclipboard) == "function" and toclipboard)

    local ok = fn and pcall(fn, text)

    status.Text = ok
        and "Copied. Paste the data in chat."
        or "Clipboard unavailable. Use Save."
end)

connect(save.Activated, function()
    if type(writefile) ~= "function" then
        status.Text = "File saving unavailable. Use Copy."
        return
    end

    local filename = "kitchen_"
        .. os.date("%Y%m%d_%H%M%S")
        .. "_"
        .. Http:GenerateGUID(false):sub(1, 6)
        .. ".json"

    local content = export()

    if type(makefolder) == "function" then
        pcall(makefolder, "InteractionLogs")
    end

    local target = "InteractionLogs/" .. filename
    local ok = pcall(writefile, target, content)

    if not ok then
        target = filename
        ok = pcall(writefile, target, content)
    end

    status.Text = ok
        and ("Saved: workspace/" .. target)
        or "Could not save. Use Copy."
end)

fullCapture()

task.spawn(function()
    local tick = 0

    while alive do
        task.wait(0.4)
        if not alive then break end

        local ok, err = pcall(function()
            poll(false)

            tick += 1

            if tick % 3 == 0 then
                captureWorld(false)
            end
        end)

        if not ok then
            changed("ERROR", tostring(err), false)
        end
    end
end)
