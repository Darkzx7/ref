local function log(kind, data)
    if not alive then return end

    if #records >= MAX_RECORDS then
        table.remove(records, 1)
        dropped += 1
    end

    records[#records + 1] = {
        t = math.round((os.clock() - started) * 100) / 100,
        kind = kind,
        data = data,
    }

    count.Text = string.format(
        "%d records | %d discarded",
        #records,
        dropped
    )
end

