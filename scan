local position, drag, cameraConnection

local function fit()
    local camera = World.CurrentCamera
    local size = camera and camera.ViewportSize or Vector2.new(800, 600)

    scale.Scale = math.max(
        0.1, math.min(1, (size.X - 24) / 440, (size.Y - 24) / 310)
    )

    position = position or Vector2.new(
        (size.X - 440 * scale.Scale) / 2,
        (size.Y - 310 * scale.Scale) / 2
    )

    position = Vector2.new(
        math.max(12, math.min(position.X, size.X - 440 * scale.Scale - 12)),
        math.max(12, math.min(position.Y, size.Y - 310 * scale.Scale - 12))
    )

    frame.Position = UDim2.fromOffset(position.X, position.Y)
end

local function bindCamera()
    if cameraConnection then cameraConnection:Disconnect() end
    local camera = World.CurrentCamera
    cameraConnection = camera
        and camera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
    fit()
end

connect(gui.Destroying, function()
    alive = false
    disconnect(connections)
    disconnect(charConnections)
    for _, list in pairs(watched) do disconnect(list) end
    if cameraConnection then cameraConnection:Disconnect() end
end)

connect(World:GetPropertyChangedSignal("CurrentCamera"), bindCamera)

connect(title.InputBegan, function(i)
    if not drag and (
        i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch
    ) then
        drag = {input = i, start = i.Position, origin = position}
    end
end)

connect(Input.InputChanged, function(i)
    if not drag then return end
    local touch = drag.input.UserInputType == Enum.UserInputType.Touch

    if (touch and i ~= drag.input)
        or (not touch and i.UserInputType ~= Enum.UserInputType.MouseMovement) then
        return
    end

    position = Vector2.new(
        drag.origin.X + i.Position.X - drag.start.X,
        drag.origin.Y + i.Position.Y - drag.start.Y
    )
    fit()
end)

connect(Input.InputEnded, function(i)
    if drag and (
        i == drag.input or (
            drag.input.UserInputType == Enum.UserInputType.MouseButton1
            and i.UserInputType == Enum.UserInputType.MouseButton1
        )
    ) then drag = nil end
end)

connect(Input.WindowFocusReleased, function() drag = nil end)
