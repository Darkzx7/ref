local root, lastPosition

local function characterAdded(character)
    disconnect(charConnections)
    charConnections = {}
    root, lastPosition = nil, nil

    log("CHARACTER", "Spawn", character)

    local contacts = setmetatable({}, { __mode = "k" })

    local function addPart(part)
        if not part:IsA("BasePart") then return end

        if part.Name == "HumanoidRootPart" then
            root, lastPosition = part, part.Position
        end

        connect(part.Touched, function(other)
            if other:IsDescendantOf(character) then return end

            local now = os.clock()
            if now - (contacts[other] or -math.huge) < 1 then return end

            contacts[other] = now
            log("TOUCH", other)
        end, charConnections)
    end

    connect(character.DescendantAdded, addPart, charConnections)

    for _, part in ipairs(character:GetDescendants()) do
        addPart(part)
    end
end

connect(player.CharacterAdded, characterAdded)

connect(player.CharacterRemoving, function()
    disconnect(charConnections)
    charConnections = {}
    root, lastPosition = nil, nil
    log("CHARACTER", "Removed")
end)

if player.Character then
    characterAdded(player.Character)
end

local sample, refresh = 0, 0

connect(Run.Heartbeat, function(dt)
    sample += dt
    refresh += dt

    if sample >= 0.1 then
        sample = 0

        if root and root.Parent then
            local current = root.Position

            if lastPosition and (current - lastPosition).Magnitude >= 25 then
                log(
                    "MOVE",
                    "Sudden displacement; cause unknown",
                    lastPosition,
                    current,
                    (current - lastPosition).Magnitude
                )
            end

            lastPosition = current
        end
    end

    if refresh < 0.25 or not dirty then return end
    refresh, dirty = 0, false

    local visible = {}

    for i = math.max(1, #logs - 59), #logs do
        visible[#visible + 1] = logs[i]
    end

    local bottom = scroll.CanvasPosition.Y + scroll.AbsoluteSize.Y
        >= scroll.AbsoluteCanvasSize.Y - 24

    output.Text = table.concat(visible, "\n")

    if bottom then
        scroll.CanvasPosition = Vector2.new(
            0,
            math.max(0, output.AbsoluteSize.Y + 12 - scroll.AbsoluteSize.Y)
        )
    end

    status.Text = string.format(
        "%s · %d logs · %d dropped\nPassive mode · perform your actions normally",
        paused and "Paused" or "Recording",
        #logs,
        dropped
    )
end)

bindCamera()
log("MONITOR", "Manual capture started")

task.spawn(function()
    local ok, objects = pcall(function()
        return game:GetDescendants()
    end)

    if not ok then
        log("MONITOR", "Some observations unavailable", objects)
        return
    end

    local slice = os.clock()

    for _, object in ipairs(objects) do
        if not alive then return end

        watch(object)

        if os.clock() - slice >= 0.003 then
            task.wait()
            slice = os.clock()
        end
    end

    log("MONITOR", "Observers ready")
end)

