local noticeUntil, notice = 0, ""

local function notify(text)
    notice, noticeUntil = text, os.clock() + 4
    monitor.dirty = true
end

-- Hook opcional. Mantém a chamada original intacta.
-- Ao fechar, desativa a captura sem sobrescrever hooks de outros scripts.
local bridge, sink

local hookOK, hookError = pcall(function()
    if type(hookmetamethod) ~= "function"
        or type(getnamecallmethod) ~= "function" then
        return
    end

    local environment = type(getgenv) == "function" and getgenv() or shared
    if type(environment) ~= "table" then return end

    bridge = environment.__CLIENT_INTERACTION_MONITOR_V1

    if type(bridge) ~= "table" or bridge.version ~= 1 then
        bridge = { version = 1 }
        local state = bridge

        local function intercept(object, ...)
            if state.sink then
                local method = getnamecallmethod()

                if method == "FireServer"
                    or method == "InvokeServer"
                    or method == "Fire"
                    or method == "Invoke"
                    or method == "Teleport"
                    or method == "TeleportAsync"
                    or method == "TeleportToPlaceInstance"
                    or method == "TeleportToSpawnByName"
                    or method == "PivotTo"
                    or method == "MoveTo"
                    or method == "Activate" then
                    pcall(state.sink, object, method, ...)
                end
            end

            return state.original(object, ...)
        end

        local wrapper = type(newcclosure) == "function"
            and newcclosure(intercept) or intercept

        state.original = hookmetamethod(game, "__namecall", wrapper)

        assert(
            type(state.original) == "function",
            "Hook did not return the original method"
        )

        environment.__CLIENT_INTERACTION_MONITOR_V1 = state
    end

    sink = function(object, method, ...)
        if not monitor.alive or monitor.paused then return end

        local class = object.ClassName
        local allowed = class == "RemoteEvent"
            or class == "UnreliableRemoteEvent"
            or class == "RemoteFunction"
            or class == "BindableEvent"
            or class == "BindableFunction"
            or object == Teleports
            or (class == "Tool" and method == "Activate")

        local char = player.Character

        if (method == "PivotTo" or method == "MoveTo") and char then
            allowed = object == char or object:IsDescendantOf(char)
        end

        if not allowed then return end

        local source = "unknown caller"

        if type(getcallingscript) == "function" then
            local ok, scriptObject = pcall(getcallingscript)
            if ok and scriptObject then source = path(scriptObject) end
        end

        monitor:Add(
            "CALL",
            path(object) .. ":" .. method .. " [" .. source .. "]",
            ...
        )
    end

    bridge.sink = sink
    monitor.outgoing = "namecall hook"
end)

if not monitor.outgoing then monitor.outgoing = "unavailable" end

if not hookOK then
    monitor:Add("MONITOR", "Outgoing capture unavailable", tostring(hookError))
end

local function watch(object)
    if not monitor.alive or watched[object]
        or object == gui or object:IsDescendantOf(gui) then
        return
    end

    local list = {}

    local function observe(signal, tag, filter)
        listen(signal, function(...)
            if not filter or filter(...) then
                monitor:Add("OBS", path(object) .. ":" .. tag, ...)
            end
        end, list)
    end

    if object:IsA("RemoteEvent") or object:IsA("UnreliableRemoteEvent") then
        observe(object.OnClientEvent, "OnClientEvent")
    elseif object:IsA("BindableEvent") then
        observe(object.Event, "Event")
    elseif object:IsA("GuiButton") then
        observe(object.Activated, "Activated")
    elseif object:IsA("ClickDetector") then
        observe(object.MouseClick, "MouseClick", function(who)
            return who == player
        end)
    elseif object:IsA("Tool") then
        local function equipped()
            return object.Parent == player.Character
        end

        observe(object.Activated, "Activated", equipped)
        observe(object.Equipped, "Equipped", equipped)
    end

    if #list > 0 then watched[object] = list end
end

local function remove(object)
    if watched[object] then
        disconnect(watched[object])
        watched[object] = nil
    end
end

listen(game.DescendantAdded, watch)
listen(game.DescendantRemoving, remove)

