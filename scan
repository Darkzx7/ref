-- Desativa a captura da versão anterior, caso exista.
pcall(function()
    local env = type(getgenv) == "function" and getgenv() or shared
    local bridge = env and env.__CLIENT_INTERACTION_MONITOR_V1
    if type(bridge) == "table" then bridge.sink = nil end
