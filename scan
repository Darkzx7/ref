local function setStatus(text, isError)
    if not tester.alive then return end
    status.Text, status.TextColor3 = text, isError and palette.danger or palette.text
end
local function filtered()
    local list, query = {}, string.lower(search.Text)
    for _, item in ipairs(tester.items) do
        local kindMatch = filterIndex == 1 or item.kind == ({ "", "remote", "local", "inspect" })[filterIndex]
        if kindMatch and (rigIndex == 1 or item.rig == rigs[rigIndex]) and string.lower(item.path):find(query, 1, true) then
            table.insert(list, item)
        end
    end
    return list
end
local function focusItem(item)
    focus = item
    detailLabel.Text = item.path
    settingArgs = true
    argsBox.Text = tester.drafts[item.ref] or "[]"
    settingArgs = false
end
local function selectionCount()
    local count = 0
    for _, item in ipairs(tester.items) do if selected[item.ref] then count += 1 end end
    return count
end
render = function()
    if not tester.alive then return end
    for _, connection in ipairs(rowsConnections) do connection:Disconnect() end
    table.clear(rowsConnections)
    for _, child in ipairs(scroll:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
    local list = view == "targets" and filtered() or logs
    local pages = math.max(1, math.ceil(#list / CONFIG.PageSize))
    page = math.clamp(page, 1, pages)
    pageLabel.Text = string.format("%d / %d   ·   %d %s", page, pages, #list, view)
    runButton.Text = "Run selected (" .. selectionCount() .. ")"
    targetsButton.TextColor3 = view == "targets" and palette.text or palette.muted
    logButton.TextColor3 = view == "logs" and palette.text or palette.muted
    if #list == 0 then label(scroll, view == "targets" and "No matching targets. Scan or adjust filters." or "No results yet.", 0, 0, 500, 42, true) end
    for index = (page - 1) * CONFIG.PageSize + 1, math.min(page * CONFIG.PageSize, #list) do
        local entry = list[index]
        local row = make("Frame", scroll, { Size = UDim2.new(1, -8, 0, 49), BackgroundColor3 = palette.card,
            BorderSizePixel = 0, LayoutOrder = index })
        round(row, 6)
        if view == "targets" then
            local choose = button(row, selected[entry.ref] and "✓" or "", 7, 12, 25, 25)
            local open = make("TextButton", row, { Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -44, 1, 0),
                Text = "", BackgroundTransparency = 1, AutoButtonColor = false })
            local name = label(open, entry.ref.Name .. "  ·  " .. entry.class, 0, 4, 450, 19)
            name.Size = UDim2.new(1, -8, 0, 19)
            local meta = label(open, entry.rig .. "  ·  " .. entry.path, 0, 26, 450, 16, true)
            meta.Size = UDim2.new(1, -8, 0, 16); meta.TextSize = 10
            table.insert(rowsConnections, choose.Activated:Connect(function()
                selected[entry.ref] = not selected[entry.ref] or nil
                focusItem(entry); render()
            end))
            table.insert(rowsConnections, open.Activated:Connect(function()
                focusItem(entry)
                local result = results[entry.ref]
                if result then setStatus(result.status:upper() .. " · " .. result.detail, result.status == "error" or result.status == "timeout") end
            end))
        else
            row.Size = UDim2.new(1, -8, 0, 0)
            row.AutomaticSize = Enum.AutomaticSize.Y
            make("UIListLayout", row, { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder })
            make("UIPadding", row, { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
                PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })
            local name = label(row, entry.status:upper() .. "  ·  " .. entry.item.path, 10, 4, 486, 19)
            if entry.status == "error" or entry.status == "timeout" then name.TextColor3 = palette.danger end
            local message = label(row, entry.detail, 10, 27, 486, 16, true)
            for order, text in ipairs({ name, message }) do
                text.LayoutOrder = order
                text.Size = UDim2.new(1, 0, 0, 0)
                text.AutomaticSize = Enum.AutomaticSize.Y
                text.TextWrapped, text.TextTruncate = true, Enum.TextTruncate.None
            end
            message.TextSize = 11
        end
    end
end
local function scan()
    if tester.scanning or tester.busy then setStatus("Wait for the current operation to finish"); return end
    setStatus("Scanning client-visible objects…")
    local ok, value = tester:Scan({ game:GetService("ReplicatedStorage"), Workspace, game:GetService("Lighting"),
        game:GetService("SoundService"), game:GetService("StarterGui"), LocalPlayer })
    if not tester.alive then return end
    if ok then
        local present = {}
        for _, item in ipairs(tester.items) do present[item.ref] = true end
        for object in pairs(selected) do if not present[object] then selected[object] = nil end end
        for object in pairs(results) do if not present[object] then results[object] = nil end end
        if focus and not present[focus.ref] then
            focus = nil; detailLabel.Text = "Select a target to edit its arguments"
            settingArgs = true; argsBox.Text = "[]"; settingArgs = false
        end
        counters.Text = tostring(value) .. " targets · " .. selectionCount() .. " selected"
        setStatus("Scan complete · client-visible objects only")
        render()
    else setStatus("Scan failed: " .. tostring(value), true) end
end
local function run(allFiltered)
    if tester.busy or tester.scanning then setStatus("Wait for the current operation to finish"); return end
    local queue = {}
    for _, item in ipairs(allFiltered and filtered() or tester.items) do
        if allFiltered or selected[item.ref] then table.insert(queue, { item = item, json = tester.drafts[item.ref] or "[]" }) end
    end
    if #queue == 0 then setStatus("Select a target first"); return end
    local function summary(counts)
        return string.format("%d sent · %d returned · %d local · %d errors · %d timeouts · %d skipped",
            counts.sent, counts.returned, counts["local"], counts.error, counts.timeout, counts.skipped)
    end
    setStatus("Running " .. #queue .. " targets…")
    tester:Run(queue, function(item, outcome, detail, index, total, counts)
        if not tester.alive then return end
        local entry = { item = item, status = outcome, detail = detail }
        results[item.ref] = entry
        table.insert(logs, 1, entry)
        if #logs > CONFIG.MaxLogs then table.remove(logs) end
        counters.Text = summary(counts)
        setStatus(string.format("%d/%d · %s · %s", index, total, outcome:upper(), item.ref.Name), outcome == "error" or outcome == "timeout")
        if view == "logs" and os.clock() - lastResultsRender >= 0.15 then
            lastResultsRender = os.clock()
            render()
        end
    end, function(stopped, counts)
        counters.Text = summary(counts)
        setStatus(stopped and "Stopped · pending local work cancelled" or "Run complete · open Results for details")
        render()
    end)
end
local function fit()
    local camera = Workspace.CurrentCamera
    local size = camera and camera.ViewportSize or Vector2.new(800, 700)
    scale.Scale = math.max(0.1, math.min(1, (size.X - 24) / 560, (size.Y - 24) / 650))
    local width, height = 560 * scale.Scale, (minimized and 55 or 650) * scale.Scale
    if not position then position = Vector2.new((size.X - width) / 2, (size.Y - height) / 2) end
    position = Vector2.new(math.clamp(position.X, 12, math.max(12, size.X - width - 12)),
        math.clamp(position.Y, 12, math.max(12, size.Y - height - 12)))
    window.Position = UDim2.fromOffset(position.X, position.Y)
end
local function bindCamera()
    if viewportConnection then viewportConnection:Disconnect() end
    local camera = Workspace.CurrentCamera
    viewportConnection = camera and camera:GetPropertyChangedSignal("ViewportSize"):Connect(fit) or nil
    fit()
end
connect(titlebar.InputBegan, function(event)
    if event.UserInputType == Enum.UserInputType.MouseButton1 or event.UserInputType == Enum.UserInputType.Touch then
        if drag then return end
        drag = { input = event, x = event.Position.X, y = event.Position.Y, origin = position }
    end
end)
connect(UserInputService.InputChanged, function(event)
    if not drag then return end
    local touch = drag.input.UserInputType == Enum.UserInputType.Touch
    if (touch and event ~= drag.input) or (not touch and event.UserInputType ~= Enum.UserInputType.MouseMovement) then return end
    position = Vector2.new(drag.origin.X + event.Position.X - drag.x, drag.origin.Y + event.Position.Y - drag.y)
    fit()
end)
connect(UserInputService.InputEnded, function(event)
    if drag and (event == drag.input or (drag.input.UserInputType == Enum.UserInputType.MouseButton1 and event.UserInputType == Enum.UserInputType.MouseButton1)) then drag = nil end
end)
connect(UserInputService.WindowFocusReleased, function() drag = nil end)
connect(Workspace:GetPropertyChangedSignal("CurrentCamera"), bindCamera)
connect(close.Activated, function() gui:Destroy() end)
connect(minimize.Activated, function()
    minimized = not minimized
    content.Visible = not minimized
    window.Size = UDim2.fromOffset(560, minimized and 55 or 650)
    minimize.Text = minimized and "+" or "–"
    fit()
end)
connect(search:GetPropertyChangedSignal("Text"), function() page = 1; render() end)
connect(argsBox:GetPropertyChangedSignal("Text"), function()
    if focus and not settingArgs then tester.drafts[focus.ref] = argsBox.Text end
end)
connect(filterButton.Activated, function() filterIndex = filterIndex % #filters + 1; filterButton.Text = filters[filterIndex]; page = 1; render() end)
connect(rigButton.Activated, function() rigIndex = rigIndex % #rigs + 1; rigButton.Text = rigs[rigIndex]; page = 1; render() end)
connect(targetsButton.Activated, function() view = "targets"; page = 1; scroll.CanvasPosition = Vector2.new(); render() end)
connect(logButton.Activated, function() view = "logs"; page = 1; scroll.CanvasPosition = Vector2.new(); render() end)
connect(prevPage.Activated, function() page -= 1; scroll.CanvasPosition = Vector2.new(); render() end)
connect(nextPage.Activated, function() page += 1; scroll.CanvasPosition = Vector2.new(); render() end)
connect(selectButton.Activated, function()
    local items, all = filtered(), true
    for _, item in ipairs(items) do if not selected[item.ref] then all = false; break end end
    for _, item in ipairs(items) do selected[item.ref] = not all or nil end
    render()
end)
connect(clearButton.Activated, function()
    if view == "logs" then table.clear(logs); table.clear(results) else table.clear(selected) end
    render()
end)
connect(autoButton.Activated, function() autoScan = not autoScan; autoButton.Text = "Auto scan: " .. (autoScan and "ON" or "OFF") end)
connect(scanButton.Activated, scan)
connect(runButton.Activated, function() run(false) end)
connect(runFiltered.Activated, function() run(true) end)
connect(stopButton.Activated, function()
    if tester.busy then tester:Stop(); setStatus("Stopping…") else setStatus("No active run") end
end)
connect(LocalPlayer.CharacterAdded, function()
    task.delay(1, function() if tester.alive and not tester.busy then scan() end end)
end)
connect(gui.Destroying, function()
    tester:Destroy()
    for _, connection in ipairs(connections) do connection:Disconnect() end
    for _, connection in ipairs(rowsConnections) do connection:Disconnect() end
    if viewportConnection then viewportConnection:Disconnect() end
end)
bindCamera()
render()
task.spawn(scan)
task.spawn(function()
    local elapsed = 0
    while tester.alive do
        elapsed += task.wait(0.5)
        if elapsed >= CONFIG.ScanInterval then
            elapsed = 0
            if autoScan and tester.alive and not tester.busy and not tester.scanning then scan() end
        end
    end
end)
