local root, lastPosition, sampleTime = nil, nil, 0

local function characterAdded(char)
    disconnect(characterConnections)
    characterConnections = {}
    root, lastPosition = nil, nil

    monitor:Add("CHAR", "Character ready", char)

    local touched = setmetatable({}, { __mode = "k" })

    local function partAdded(part)
        if part.Name == "HumanoidRootPart" and part:IsA("BasePart") then
            root, lastPosition = part, part.Position
        end

        if part:IsA("BasePart") then
            listen(part.Touched, function(other)
                if other:IsDescendantOf(char) then return end

                local now = os.clock()
                if now - (touched[other] or -math.huge) < 1 then return end

                touched[other] = now
                monitor:Add("TOUCH", other)
            end, characterConnections)
        end
    end

    listen(char.DescendantAdded, partAdded, characterConnections)

    for _, part in ipairs(char:GetDescendants()) do
        partAdded(part)
    end
end

listen(player.CharacterAdded, characterAdded)

listen(player.CharacterRemoving, function()
    disconnect(characterConnections)
    characterConnections = {}
    root, lastPosition = nil, nil
    monitor:Add("CHAR", "Character removed")
end)

if player.Character then characterAdded(player.Character) end

local position, drag, cameraConnection

local function fit()
    local camera = Workspace.CurrentCamera
    local size = camera and camera.ViewportSize or Vector2.new(800, 600)

    scale.Scale = math.max(
        0.1,
        math.min(1, (size.X - 24) / 460, (size.Y - 24) / 330)
    )

    position = position or Vector2.new(
        (size.X - 460 * scale.Scale) / 2,
        (size.Y - 330 * scale.Scale) / 2
    )

    position = Vector2.new(
        math.max(12, math.min(position.X, size.X - 460 * scale.Scale - 12)),
        math.max(12, math.min(position.Y, size.Y - 330 * scale.Scale - 12))
    )

    window.Position = UDim2.fromOffset(position.X, position.Y)
end

local function bindCamera()
    if cameraConnection then cameraConnection:Disconnect() end

    local camera = Workspace.CurrentCamera
    cameraConnection = camera
        and camera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
        or nil

    fit()
end

listen(Workspace:GetPropertyChangedSignal("CurrentCamera"), bindCamera)

listen(title.InputBegan, function(event)
    if not drag and (
        event.UserInputType == Enum.UserInputType.MouseButton1
        or event.UserInputType == Enum.UserInputType.Touch
    ) then
        drag = {
            input = event,
            x = event.Position.X,
            y = event.Position.Y,
            origin = position,
        }
    end
end)

listen(Input.InputChanged, function(event)
    if not drag then return end

    local touch = drag.input.UserInputType == Enum.UserInputType.Touch

    if (touch and event ~= drag.input)
        or (not touch and event.UserInputType ~= Enum.UserInputType.MouseMovement) then
        return
    end

    position = Vector2.new(
        drag.origin.X + event.Position.X - drag.x,
        drag.origin.Y + event.Position.Y - drag.y
    )

    fit()
end)

listen(Input.InputEnded, function(event)
    if drag and (
        event == drag.input
        or (
            drag.input.UserInputType == Enum.UserInputType.MouseButton1
            and event.UserInputType == Enum.UserInputType.MouseButton1
        )
    ) then
        drag = nil
    end
end)

listen(Input.WindowFocusReleased, function()
    drag = nil
end)

