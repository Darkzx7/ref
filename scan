local function setStatus(ui, txt, cor)
    if ui and ui.statusLabel then
        ui.statusLabel.Text = txt
        ui.statusLabel.TextColor3 = cor or Color3.fromRGB(200, 220, 255)
    end
end

local function addItem(ui, txt, cor)
    if not ui or not ui.scroll then return end
    if #ui.scroll:GetChildren() > CONFIG.MAX_ITENS_UI then
        local primeiros = {}
        for _, c in ipairs(ui.scroll:GetChildren()) do
            if c:IsA("TextLabel") then table.insert(primeiros, c) end
        end
        if primeiros[1] then primeiros[1]:Destroy() end
    end
    local item = Instance.new("TextLabel")
    item.Size = UDim2.new(1, -12, 0, 22)
    item.BackgroundColor3 = cor or Color3.fromRGB(40, 40, 60)
    item.BackgroundTransparency = 0.25
    item.BorderSizePixel = 0
    item.Text = "  " .. txt
    item.TextColor3 = Color3.fromRGB(230, 230, 255)
    item.TextSize = 11
    item.Font = Enum.Font.Code
    item.TextXAlignment = Enum.TextXAlignment.Left
    item.TextTruncate = Enum.TextTruncate.AtEnd
    item.Parent = ui.scroll
    Instance.new("UICorner", item).CornerRadius = UDim.new(0, 4)
end

local function limparLista(ui)
    if not ui or not ui.scroll then return end
    for _, c in ipairs(ui.scroll:GetChildren()) do
        if c:IsA("TextLabel") then c:Destroy() end
    end
end

-- ============================================================
--  COLETA UNIVERSAL DE PAYLOADS
--  Estrutura: { nome, tipo, ref, rig, args }
-- ============================================================
local payloads = {}

local function add(nome, tipo, ref, rig, args)
    table.insert(payloads, {
        nome = nome, tipo = tipo, ref = ref,
        rig = rig or "ANY", args = args or {},
    })
end

-- Assinaturas comuns testadas em FireServer
local ASSINATURAS = {
    {},                                -- ()
    {LocalPlayer},                     -- (player)
    {"R15"},                           -- ("R15")
    {"R6"},                            -- ("R6")
    {LocalPlayer.Character},           -- (character)
    {true},                            -- (true)
    {1},                               -- (1)
    {"fire"},                          -- ("fire")
    {"attack"},                        -- ("attack")
    {"payload"},                       -- ("payload")
    {"all"},                           -- ("all")
    {LocalPlayer, "R15"},              -- (player, "R15")
    {LocalPlayer.Character, "R15"},    -- (character, "R15")
}

-- ============================================================
--  SCANNERS (TODOS OS SERVIÇOS / LOCAIS)
-- ============================================================
local function scanService(service, prefixo)
    if not service then return end
    local ok, desc = pcall(function() return service:GetDescendants() end)
    if not ok or not desc then return end
    for _, obj in ipairs(desc) do
        local cls = obj.ClassName
        local rig = detectarRigPorNome(obj.Name)
        if rig == "ANY" then
            rig = detectarRigPorEstrutura(obj)
        end

        if obj:IsA("RemoteEvent") then
            add(prefixo .. "." .. obj:GetFullName(), "RemoteEvent", obj, rig)
        elseif obj:IsA("RemoteFunction") then
            add(prefixo .. "." .. obj:GetFullName(), "RemoteFunction", obj, rig)
        elseif obj:IsA("BindableEvent") then
            add(prefixo .. "." .. obj:GetFullName(), "BindableEvent", obj, rig)
        elseif obj:IsA("BindableFunction") then
            add(prefixo .. "." .. obj:GetFullName(), "BindableFunction", obj, rig)
        elseif obj:IsA("UnreliableRemoteEvent") then
            add(prefixo .. "." .. obj:GetFullName(), "UnreliableRemoteEvent", obj, rig)
        end
    end
end

local function scanModulos()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("ModuleScript") then
            local ok, mod = pcall(require, obj)
            if ok and type(mod) == "table" then
                for k, v in pairs(mod) do
                    if type(v) == "function" then
                        local rig = detectarRigPorNome(tostring(k))
                        add(obj.Name .. "." .. tostring(k), "ModuleFunction",
                            {mod = mod, key = k}, rig)
                    end
                end
            end
        end
    end
end

local function scanWorkspace()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = string.lower(obj.Name)
            if n:find("payload") or n:find("trigger") or n:find("event")
               or n:find("fire") or n:find("button") or n:find("touch") then
                local rig = detectarRigPorEstrutura(obj.Parent) or "ANY"
                if rig == "ANY" then rig = detectarRigPorNome(obj.Name) end
                add("Workspace." .. obj:GetFullName(), "PartTrigger", obj, rig)
            end
        elseif obj:IsA("Sound") then
            add("Sound." .. obj:GetFullName(), "Sound", obj, "ANY")
        elseif obj:IsA("Animation") then
            add("Animation." .. obj:GetFullName(), "Animation", obj, "ANY")
        elseif obj:IsA("ProximityPrompt") then
            add("Prompt." .. obj:GetFullName(), "ProximityPrompt", obj, "ANY")
        elseif obj:IsA("ClickDetector") then
            add("Click." .. obj:GetFullName(), "ClickDetector", obj, "ANY")
        elseif obj:IsA("TouchTransmitter") then
            add("Touch." .. obj:GetFullName(), "TouchTransmitter", obj, "ANY")
        end
    end
end

local function scanCharacter()
    local char = LocalPlayer.Character
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            add("Char." .. obj.Name, "RemoteEvent", obj, "R15")
        elseif obj:IsA("BasePart") then
            -- nada por padrão; não dispara em cada parte pra não floodar
        elseif obj:IsA("Sound") then
            add("CharSound." .. obj.Name, "Sound", obj, "R15")
        end
    end
end

local function scanPlayerGui()
    for _, obj in ipairs(LocalPlayer:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            add("Player." .. obj.Name, "RemoteEvent", obj, "ANY")
        elseif obj:IsA("BindableEvent") then
            add("Player." .. obj.Name, "BindableEvent", obj, "ANY")
        end
    end
end

local function scanBackpackETools()
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    local char = LocalPlayer.Character
    local alvos = {}
    if bp then table.insert(alvos, bp) end
    if char then table.insert(alvos, char) end
    for _, cont in ipairs(alvos) do
        for _, tool in ipairs(cont:GetChildren()) do
            if tool:IsA("Tool") then
                for _, d in ipairs(tool:GetDescendants()) do
                    if d:IsA("RemoteEvent") then
                        add("Tool." .. tool.Name .. "." .. d.Name, "RemoteEvent", d, "R15")
                    elseif d:IsA("RemoteFunction") then
                        add("Tool." .. tool.Name .. "." .. d.Name, "RemoteFunction", d, "R15")
                    end
                end
                -- ativa a tool também
                add("ToolActivate." .. tool.Name, "ToolActivate", tool, "R15")
            end
        end
    end
end

local function scanTudo()
    payloads = {}

    scanService(ReplicatedStorage, "RS")
    scanService(ServerStorage,     "SS")
    scanService(Workspace,         "WS")
    scanService(Lighting,          "LT")
    scanService(SoundService,      "SND")
    scanService(StarterGui,        "SG")

    scanModulos()
    scanWorkspace()
    scanCharacter()
    scanPlayerGui()
    scanBackpackETools()

    -- Ordena R15 → R6 → ANY
    table.sort(payloads, function(a, b)
        local ordem = { R15 = 1, R6 = 2, ANY = 3 }
        local oa, ob = ordem[a.rig] or 4, ordem[b.rig] or 4
        if oa ~= ob then return oa < ob end
        return a.nome < b.nome
    end)

    return #payloads
end

-- ============================================================
--  DISPARO UNIVERSAL (tenta tudo em cada payload)
-- ============================================================
local function dispararRemoteEvent(remote)
    -- Tenta várias assinaturas comuns; para na primeira que não der erro
    local tentativas = 0
    for _, args in ipairs(ASSINATURAS) do
        tentativas = tentativas + 1
        local ok = pcall(function()
            remote:FireServer(table.unpack(args))
        end)
        if ok then
            return true, "FireServer(" .. #args .. " args)"
        end
        if not CONFIG.TENTAR_VARIAS_ASSINATURAS then break end
    end
    -- se nenhuma funcionou, tenta ao menos uma vez direto
    local ok = pcall(function() remote:FireServer() end)
    return ok, ok and "FireServer()" or "falhou em todas assinaturas"
end

local function dispararRemoteFunction(rf)
    for _, args in ipairs(ASSINATURAS) do
        local ok = pcall(function()
            rf:InvokeServer(table.unpack(args))
        end)
        if ok then
            return true, "InvokeServer(" .. #args .. " args)"
        end
        if not CONFIG.TENTAR_VARIAS_ASSINATURAS then break end
    end
    return false, "InvokeServer falhou"
end

local function dispararPayload(p)
    local ok, info = pcall(function()
        local t = p.tipo
        if t == "RemoteEvent" or t == "UnreliableRemoteEvent" then
            return dispararRemoteEvent(p.ref)
        elseif t == "RemoteFunction" then
            return dispararRemoteFunction(p.ref)
        elseif t == "BindableEvent" then
            p.ref:Fire()
            return true, "BindableEvent:Fire()"
        elseif t == "BindableFunction" then
            p.ref:Invoke()
            return true, "BindableFunction:Invoke()"
        elseif t == "ModuleFunction" then
            p.ref.mod[p.ref.key]()
            return true, "Module." .. tostring(p.ref.key)
        elseif t == "PartTrigger" then
            local obj = p.ref
            local s = obj:FindFirstChildOfClass("Sound")
            if s then s:Play() end
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
            if prompt then prompt:InputHoldBegin(); task.wait(0.05); prompt:InputHoldEnd() end
            local cd = obj:FindFirstChildOfClass("ClickDetector")
            if cd then
                for _, plr in ipairs(Players:GetPlayers()) do
                    pcall(function() cd.MouseClick:Fire(plr) end)
                end
            end
            return true, "PartTrigger acionado"
        elseif t == "Sound" then
            p.ref:Play()
            return true, "Sound:Play()"
        elseif t == "ProximityPrompt" then
            p.ref:InputHoldBegin(); task.wait(0.05); p.ref:InputHoldEnd()
            return true, "Prompt acionado"
        elseif t == "ClickDetector" then
            for _, plr in ipairs(Players:GetPlayers()) do
                pcall(function() p.ref.MouseClick:Fire(plr) end)
            end
            return true, "ClickDetector fire"
        elseif t == "TouchTransmitter" then
            local part = p.ref.Parent
            if part and LocalPlayer.Character then
                pcall(function() p.ref:Fire(LocalPlayer.Character) end)
            end
            return true, "Touch fire"
        elseif t == "ToolActivate" then
            pcall(function() p.ref:Activate() end)
            return true, "Tool:Activate()"
        elseif t == "Animation" then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                local anim = hum:LoadAnimation(p.ref)
                anim:Play()
            end
            return true, "Animation:Play()"
        end
        return false, "tipo desconhecido: " .. tostring(t)
    end)

    if not ok then return false, tostring(info) end
    -- info agora é (bool, string)
    if type(info) == "table" then
        return info[1], info[2]
    end
    return true, tostring(info)
end

-- ============================================================
--  LOOP DE DISPARO
-- ============================================================
local disparando = false
local pararSolicitado = false

local function dispararTodos(ui)
    if disparando then return end
    disparando = true
    pararSolicitado = false

    local total = #payloads
    if total == 0 then
        setStatus(ui, "❌ Nenhum payload. Escaneie primeiro.", Color3.fromRGB(255, 100, 100))
        disparando = false
        return
    end

    limparLista(ui)
    setStatus(ui, "🚀 Disparando " .. total .. " payloads...", Color3.fromRGB(100, 200, 255))

    local disparados, falhas = 0, 0

    for i, p in ipairs(payloads) do
        if pararSolicitado then
            setStatus(ui, "⏹ Parado pelo usuário.", Color3.fromRGB(255, 200, 80))
            break
        end

        if CONFIG.MOSTRAR_APENAS_R15 and p.rig ~= "R15" then
            -- pula
        else
            local ok, msg = dispararPayload(p)
            if ok then
                disparados = disparados + 1
                addItem(ui, "✅ [" .. p.rig .. "] " .. p.nome .. " → " .. tostring(msg),
                    Color3.fromRGB(35, 75, 50))
            else
                falhas = falhas + 1
                addItem(ui, "❌ [" .. p.rig .. "] " .. p.nome .. " → " .. tostring(msg):sub(1, 50),
                    Color3.fromRGB(80, 40, 40))
            end

            ui.counterLabel.Text = string.format("📦 %d | ✅ %d | ❌ %d | %d/%d",
                total, disparados, falhas, i, total)
            setStatus(ui, "⏳ " .. p.nome .. " (" .. i .. "/" .. total .. ")",
                Color3.fromRGB(255, 220, 100))

            task.wait(CONFIG.DELAY_ENTRE_PAYLOADS)
        end
    end

    setStatus(ui, "✅ Fim! " .. disparados .. " ok, " .. falhas .. " falhas.",
        Color3.fromRGB(100, 255, 150))
    disparando = false
end

