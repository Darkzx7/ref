local Players = game:GetService("Players")
local Http = game:GetService("HttpService")
local Input = game:GetService("UserInputService")
local Prompts = game:GetService("ProximityPromptService")

local player = Players.LocalPlayer
assert(player, "Run this on the client.")

local pg = player:WaitForChild("PlayerGui")
local old = pg:FindFirstChild("KitchenCollector")
if old then old:Destroy() end

local alive, minimized = true, false
local connections, records, previous = {}, {}, {}
local watched = setmetatable({}, {__mode = "k"})
local started, dropped = os.clock(), 0
local MAX_RECORDS = 1600

local names = {
    "StorageList_Refrigerator",
    "StorageList_Freezer",
    "OvercookedProcessorContainer",
    "ProximityPromptDialog",
    "Action",
    "Prompt",
}

local function connect(signal, callback)
    local c = signal:Connect(callback)
    connections[#connections + 1] = c
    return c
end

local function path(obj)
    return obj:GetFullName()
end

local function vector(v)
    return {
        x = math.round(v.X * 100) / 100,
        y = math.round(v.Y * 100) / 100,
        z = math.round(v.Z * 100) / 100,
    }
end

local function position()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    return root and vector(root.Position) or nil
end

local function attributes(obj)
    local out = {}

    for key, value in pairs(obj:GetAttributes()) do
        local kind = typeof(value)
        out[key] = (
            kind == "string"
            or kind == "boolean"
            or kind == "number"
        ) and value or tostring(value)
    end

    return out
end

local function visible(obj)
    local current = obj

    while current and current ~= pg do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        end

        if current:IsA("ScreenGui") and not current.Enabled then
            return false
        end

        current = current.Parent
    end

    return current == pg
end

