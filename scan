-- Observadores passivos: não chama FireServer/InvokeServer.
local function watch(object)
    if not alive or watched[object]
        or object == gui or object:IsDescendantOf(gui) then return end

    local list = {}

    local function observe(signal, kind, filter)
        connect(signal, function(...)
            if not filter or filter(...) then
                log(kind, object, ...)
            end
        end, list)
    end

    local ok = pcall(function()
        if object:IsA("RemoteEvent") or object:IsA("UnreliableRemoteEvent") then
            observe(object.OnClientEvent, "REMOTE IN")

        elseif object:IsA("BindableEvent") then
            observe(object.Event, "LOCAL EVENT")

        elseif object:IsA("GuiButton") then
            observe(object.Activated, "UI CLICK")

        elseif object:IsA("ClickDetector") then
            observe(object.MouseClick, "WORLD CLICK", function(who)
                return who == player
            end)

        elseif object:IsA("Tool") then
            local function equipped()
                return object.Parent == player.Character
            end
            observe(object.Equipped, "TOOL EQUIP", equipped)
            observe(object.Activated, "TOOL USE", equipped)
            observe(object.Deactivated, "TOOL RELEASE", equipped)
        end
    end)

    if not ok then
        disconnect(list)
    elseif #list > 0 then
        watched[object] = list
    end
end

connect(game.DescendantAdded, watch)

connect(game.DescendantRemoving, function(object)
    if watched[object] then
        disconnect(watched[object])
        watched[object] = nil
    end
end)

