local function requiredModule(parts)
    local at=RS
    for _,name in ipairs(parts) do at=at:FindFirstChild(name);assert(at,"missing module: "..table.concat(parts,".")) end
    return require(at)
end
local function initialize()
    Physics=requiredModule({"Modules","SnookerPhysics"})
    Config=requiredModule({"Configuration","Snooker"})
    Client=requiredModule({"Client","Snooker"})
    Blink=requiredModule({"Blink","Client"})
    for _,name in ipairs({"BuildFrame","NewState","AddBall","GetBall","ApplyStrike","Step","Settled","WorldToLocal","LocalToWorld"}) do
        assert(type(Physics[name])=="function","physics missing "..name)
    end
    assert(Blink.Snooker and Blink.Snooker.Strike and type(Blink.Snooker.Strike.Fire)=="function","strike API unavailable")
    assert(type(getups)=="function","executor needs debug.getupvalues for the native shot")
    local matches={}
    for _,fn in pairs(ups(Client.Start)) do
        if type(fn)~="function" then continue end
        local hasPhysics,hasConfig=false,false
        for _,value in pairs(ups(fn)) do
            if value==Physics then hasPhysics=true end
            if value==Config then hasConfig=true end
        end
        if hasPhysics and hasConfig then matches[#matches+1]=fn end
        if debug and type(debug.info)=="function" then
            local ok,name=pcall(debug.info,fn,"n")
            if ok and name=="TrackPointer" then pointerFn=fn end
        end
    end
    assert(#matches==1,"cannot identify native RunShot; no shot was sent")
    nativeShot=matches[1]
    local maps={}
    for _,value in pairs(ups(nativeShot)) do
        if type(value)=="table" and value~=Physics and value~=Config and type(value.Fire)~="function" then maps[#maps+1]=value end
    end
    assert(#maps==1,"cannot identify active shot state")
    simulations=maps[1]
    if pointerFn then
        for index,value in pairs(ups(pointerFn)) do
            if index~=1 or (value~=nil and typeof(value)~="Vector2") then pointerFn=nil;break end
        end
    end
    local assets=RS:FindFirstChild("Assets")
    assert(assets and assets:FindFirstChild("Snooker") and assets.Snooker:FindFirstChild("Ball"),"ball asset unavailable")
    log("native physics + RunShot ready; pointer: "..tostring(pointerFn~=nil and type(setup)=="function"))
end
