    local clipboard = type(setclipboard) == "function" and setclipboard
        or (type(toclipboard) == "function" and toclipboard or nil)

    if clipboard and pcall(clipboard, export) then
        showStatus("Logs copied")
    else
        manual.Text = export
        manual.Visible, scroll.Visible = true, false
        manual:CaptureFocus()
        manual.SelectionStart = 1
        manual.CursorPosition = #export + 1
        showStatus("Text selected — copy manually")
    end
end)

-- Salva um arquivo novo a cada clique.
connect(save.Activated, function()
    if type(writefile) ~= "function" then
        showStatus("File saving unavailable in this executor. Use Copy logs.")
        return
    end

    local prepared, filename, export = pcall(function()
        local name = os.date("%Y-%m-%d_%H-%M-%S")
            .. "_" .. HttpService:GenerateGUID(false):sub(1, 8) .. ".txt"
        return name, exportLogs()
    end)

    if not prepared then
        showStatus("Could not prepare the log file.")
        return
    end

    local folder = "InteractionLogs"
    local useFolder = false

    if type(isfolder) == "function" then
        local ok, exists = pcall(isfolder, folder)
        useFolder = ok and exists == true
    end

    if not useFolder and type(makefolder) == "function" then
        local ok, result = pcall(makefolder, folder)
        useFolder = ok and result ~= false

        if not useFolder and type(isfolder) == "function" then
            local checked, exists = pcall(isfolder, folder)
            useFolder = checked and exists == true
        end
    end

    local destination = useFolder
        and (folder .. "/" .. filename)
        or ("interaction_log_" .. filename)

    local ok, result = pcall(writefile, destination, export)

    -- Alguns executores não permitem subpastas.
    if (not ok or result == false) and useFolder then
        destination = "interaction_log_" .. filename
        ok, result = pcall(writefile, destination, export)
    end

    if ok and result ~= false then
        showStatus("Saved: " .. destination)
    else
        showStatus("Save failed. Use Copy logs.")
    end
end)

