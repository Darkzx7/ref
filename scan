-- ============================================================
--  UTILITÁRIOS
-- ============================================================
local function isR15(character)
    if not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum and hum.RigType == Enum.HumanoidRigType.R15 then return true end
    -- fallback: procura partes R15
    for _, nome in ipairs({"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftHand","RightHand","LeftFoot","RightFoot"}) do
        if character:FindFirstChild(nome) then return true end
    end
    return false
end

local function detectarRigPorNome(nome)
    local n = string.lower(nome)
    if n:find("r15") then return "R15" end
    if n:find("r6")  then return "R6"  end
    return "ANY"
end

local function detectarRigPorEstrutura(inst)
    if not inst then return "ANY" end
    -- procura descendentes com nomes R15/R6
    local ok, desc = pcall(function() return inst:GetDescendants() end)
    if ok and desc then
        for _, d in ipairs(desc) do
            if d.Name == "UpperTorso" or d.Name == "LowerTorso" then return "R15" end
            if d.Name == "Torso" and d:IsA("BasePart") then
                -- checa se NÃO tem UpperTorso junto (aí é R6)
                local parent = d.Parent
                if parent and not parent:FindFirstChild("UpperTorso") then
                    return "R6"
                end
            end
        end
    end
    return "ANY"
end

