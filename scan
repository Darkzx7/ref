local function pointSegment(p,a,b)
    local v=b-a
    local t=v:Dot(v)>1e-12 and math.clamp((p-a):Dot(v)/v:Dot(v),0,1) or 0
    return (p-a-v*t).Magnitude
end
local function legalTargets(snap,team,solids)
    local allowed={}
    local assigned=solids==1 or solids==2
    local lo,hi=1,15
    if assigned then lo,hi=team==solids and 1 or 9,team==solids and 7 or 15 end
    for _,b in ipairs(snap) do
        if not b.pocketed and b.id~=0 and b.id~=8 and b.id>=lo and b.id<=hi then allowed[b.id]=true end
    end
    if assigned and not next(allowed) then allowed[8]=true end
    return allowed
end
local function newState(frame,snap)
    local s=Physics.NewState(frame)
    for _,b in ipairs(snap) do Physics.AddBall(s,b.id,b.pos).Pocketed=b.pocketed end
    return s
end
-- Backward unfolding includes the cushion's normal restitution, rather than an ideal mirror.
local function railPath(a,b,rails,frame,pockets)
    local e=Config.GetRestitution()
    local unfolded=b
    for i=#rails,1,-1 do
        local r=rails[i]
        if r.axis==1 then unfolded=Vector3.new(r.k+(r.k-unfolded.X)/e,unfolded.Y,0)
        else unfolded=Vector3.new(unfolded.X,r.k+(r.k-unfolded.Y)/e,0) end
    end
    local delta=unfolded-a
    if delta.Magnitude<1e-7 then return end
    local dir=delta.Unit
    local path={a}
    local at=a
    local length=0
    local l,w=frame.HalfLong-frame.Diameter*.5,frame.HalfShort-frame.Diameter*.5
    for _,r in ipairs(rails) do
        local denominator=r.axis==1 and dir.X or dir.Y
        if math.abs(denominator)<1e-7 then return end
        local distance=(r.k-(r.axis==1 and at.X or at.Y))/denominator
        if distance<=1e-5 then return end
        local hit=at+dir*distance
        if math.abs(hit.X)>l+1e-4 or math.abs(hit.Y)>w+1e-4 then return end
        for _,p in ipairs(pockets) do
            if (p-hit).Magnitude<frame.Diameter*.5*Config.GetPocketRadiusFactor()+.02 then return end
        end
        length+=distance;path[#path+1]=hit;at=hit
        dir=(r.axis==1 and Vector3.new(-dir.X*e,dir.Y,0) or Vector3.new(dir.X,-dir.Y*e,0)).Unit
    end
    local final=b-at
    if final.Magnitude<1e-6 or final.Unit:Dot(dir)<.999 then return end
    length+=final.Magnitude;path[#path+1]=b
    return path,length
end
local function candidates(frame,snap,allowed)
    local white
    for _,b in ipairs(snap) do if b.id==0 and not b.pocketed then white=b end end
    if not white then return {} end
    local d=frame.Diameter
    local pockets=Physics.NewState(frame).Pockets
    local l,w=frame.HalfLong-d*.5,frame.HalfShort-d*.5
    local rails={{axis=1,k=l},{axis=1,k=-l},{axis=2,k=w},{axis=2,k=-w}}
    local groups={direct={},bank={},kick={},double={},combo={},safety={}}
    local function clear(a,b,ignoreA,ignoreB)
        for _,o in ipairs(snap) do
            if not o.pocketed and o.id~=ignoreA and o.id~=ignoreB and pointSegment(o.pos,a,b)<d*.995 then return false end
        end
        return true
    end
    local function routeClear(path,id,other,cue)
        for i=1,#path-1 do
            local second=cue and (i==#path-1 and id or nil) or other
            if not clear(path[i],path[i+1],cue and 0 or id,second) then return false end
        end
        return true
    end
    local function add(target,objectPath,objectDistance,cueRails,kind,second,exitCos)
        local objectDir=(objectPath[2]-objectPath[1]).Unit
        local ghost=target.pos-objectDir*d
        if math.abs(ghost.X)>l or math.abs(ghost.Y)>w then return end
        local cuePath,cueDistance
        if #cueRails>0 then cuePath,cueDistance=railPath(white.pos,ghost,cueRails,frame,pockets)
        else cuePath={white.pos,ghost};cueDistance=(ghost-white.pos).Magnitude end
        if not cuePath or cueDistance<1e-6 then return end
        local arrival=(cuePath[#cuePath]-cuePath[#cuePath-1]).Unit
        local cosine=arrival:Dot(objectDir)
        if cosine<.16 or not routeClear(cuePath,target.id,nil,true) then return end
        if not routeClear(objectPath,target.id,second or 0,false) then return end
        local railCount=#cueRails+#objectPath-2
        local energy=cueDistance+(objectDistance+d*4)/(cosine*cosine*(exitCos or 1)^2)
        energy/=math.max(.25,Config.GetRestitution()^(railCount*2))
        local base=math.sqrt(2*Config.GetDecel()*energy)/Config.GetMaxImpulse()
        if base>1.2 then return end
        local start=(cuePath[2]-white.pos).Unit
        groups[kind][#groups[kind]+1]={id=target.id,dir=(frame.Long*start.X+frame.Short*start.Y).Unit,
            base=base,rank=cosine*4-cueDistance*.04-objectDistance*.035-railCount*.28,
            kind=kind,cuePath=cuePath,objectPath=objectPath,ghost=ghost,target=target.pos,pocket=objectPath[#objectPath]}
    end
    for _,target in ipairs(snap) do
        if target.pocketed or not allowed[target.id] then continue end
        for _,pocket in ipairs(pockets) do
            if (pocket-target.pos).Magnitude<1e-6 then continue end
            local direct={target.pos,pocket}
            local length=(pocket-target.pos).Magnitude
            add(target,direct,length,{},"direct")
            for _,r in ipairs(rails) do
                local bank,dist=railPath(target.pos,pocket,{r},frame,pockets)
                if bank then
                    add(target,bank,dist,{},"bank")
                    for _,cueRail in ipairs(rails) do add(target,bank,dist,{cueRail},"double") end
                end
                add(target,direct,length,{r},"kick")
            end
            for i,r1 in ipairs(rails) do
                for j,r2 in ipairs(rails) do
                    if i==j then continue end
                    local bank,dist=railPath(target.pos,pocket,{r1,r2},frame,pockets)
                    if bank then add(target,bank,dist,{},"double") end
                    add(target,direct,length,{r1,r2},"double")
                end
            end
            -- Legal ball-to-ball combination: the first contact and the potted ball are ours.
            for _,other in ipairs(snap) do
                if other.id==target.id or other.pocketed or not allowed[other.id] then continue end
                local exit=pocket-other.pos
                if exit.Magnitude<1e-6 then continue end
                local nextGhost=other.pos-exit.Unit*d
                local incoming=nextGhost-target.pos
                if incoming.Magnitude<d then continue end
                local cosine=incoming.Unit:Dot(exit.Unit)
                if cosine>.25 and clear(other.pos,pocket,other.id,0) then
                    add(target,{target.pos,nextGhost},incoming.Magnitude+exit.Magnitude/(cosine*cosine),{},"combo",other.id)
                end
            end
        end
        -- Recovery contacts also go around blockers via one or two cushions.
        local recoveryRoutes={{}}
        for i,r1 in ipairs(rails) do
            recoveryRoutes[#recoveryRoutes+1]={r1}
            for j,r2 in ipairs(rails) do
                if i~=j then
                    recoveryRoutes[#recoveryRoutes+1]={r1,r2}
                    for k,r3 in ipairs(rails) do if k~=j then recoveryRoutes[#recoveryRoutes+1]={r1,r2,r3} end end
                end
            end
        end
        for _,rs in ipairs(recoveryRoutes) do
            local path,distance
            if #rs==0 then path={white.pos,target.pos};distance=(target.pos-white.pos).Magnitude
            else path,distance=railPath(white.pos,target.pos,rs,frame,pockets) end
            if path and distance>d then
                local dir=(path[2]-path[1]).Unit
                groups.safety[#groups.safety+1]={id=target.id,dir=(frame.Long*dir.X+frame.Short*dir.Y).Unit,
                    kind="safety",rank=-distance,base=math.max(.24,math.sqrt(2*Config.GetDecel()*(distance+d*12))/Config.GetMaxImpulse()),
                    cuePath=path,objectPath={},target=target.pos,ghost=target.pos}
            end
        end
    end
    for _,g in pairs(groups) do table.sort(g,function(a,b)return a.rank>b.rank end) end
    local result={}
    -- Each route family gets turns; direct candidates cannot starve cushions or combinations.
    for index=1,48 do
        for _,kind in ipairs({"direct","bank","kick","double","combo","safety"}) do
            if groups[kind][index] then result[#result+1]=groups[kind][index] end
        end
    end
    return result
end
local function rollout(frame,snap,allowed,c,power,angle)
    local dir=c.dir
    if angle and angle~=0 then
        local a=math.atan2(dir.Z,dir.X)+angle
        dir=Vector3.new(math.cos(a),0,math.sin(a))
    end
    local s=newState(frame,snap)
    Physics.ApplyStrike(s,power,dir)
    return {state=s,frame=frame,snap=snap,allowed=allowed,c=c,power=power,dir=dir,steps=0,pocketed={},clearance=math.huge}
end
local function rolloutStep(r)
    local s=r.state
    local cue=Physics.GetBall(s,0)
    local before=cue and cue.Pos
    local event=Physics.Step(s)
    r.steps+=1
    for _,id in ipairs(event.Pocketed) do r.pocketed[id]=true end
    -- Confirm a real transfer of motion, not a projected contact beyond a cushion.
    if not r.firstHit and before then
        local nearest,chosen=math.huge,nil
        for _,b in ipairs(s.Balls) do
            if b.Id~=0 and b.Vel.Magnitude>1e-7 then
                local distance=(b.Pos-before).Magnitude
                if distance<nearest then nearest,chosen=distance,b.Id end
            end
        end
        if chosen then r.firstHit=chosen end
    end
    if cue then
        for _,p in ipairs(s.Pockets) do r.clearance=math.min(r.clearance,(cue.Pos-p).Magnitude-s.PocketRadius) end
    end
    if r.pocketed[0] or (r.pocketed[8] and not r.allowed[8]) or (r.firstHit and not r.allowed[r.firstHit]) then return true end
    if Physics.Settled(s) then
        if not r.firstHit or r.clearance<r.frame.Diameter*.04 then return true end
        local own,opponent=0,0
        for id in pairs(r.pocketed) do
            if r.allowed[id] then own+=1 else opponent+=1 end
        end
        if opponent>0 then return true end
        r.result={own=own,score=own*1000+math.min(r.clearance,2)*5-r.power*.3,clearance=r.clearance,pocketed=table.clone(r.pocketed)}
        return true
    end
    return r.steps>=math.ceil(Config.GetMaxSimTime()/Config.GetFixedDt())
end
-- Numeric broad search; only candidates checked again by the live game physics may be fired.
local function fastRollout(frame,snap,allowed,c,power,angle)
    local dir=c.dir
    if angle and angle~=0 then
        local a=math.atan2(dir.Z,dir.X)+angle;dir=Vector3.new(math.cos(a),0,math.sin(a))
    end
    local vx,vy=dir:Dot(frame.Long),dir:Dot(frame.Short)
    local mag=math.sqrt(vx*vx+vy*vy)
    local speed=power*Config.GetMaxImpulse()
    local r={fast=true,c=c,power=power,dir=dir,frame=frame,allowed=allowed,steps=0,pocketed={},clearance=math.huge,
        balls={},dt=Config.GetFixedDt(),decel=Config.GetDecel(),e=Config.GetRestitution(),rest=Config.GetRestSpeed(),
        d=frame.Diameter,limit=math.ceil(Config.GetMaxSimTime()/Config.GetFixedDt()),near=math.huge}
    local hl,hs=frame.HalfLong,frame.HalfShort
    r.l=hl-r.d*.5;r.w=hs-r.d*.5;r.pr=r.d*.5*Config.GetPocketRadiusFactor()
    r.pockets={{hl,hs},{hl,-hs},{-hl,hs},{-hl,-hs},{0,hs},{0,-hs}}
    for _,b in ipairs(snap) do
        r.balls[#r.balls+1]={id=b.id,x=b.pos.X,y=b.pos.Y,vx=b.id==0 and vx/mag*speed or 0,
            vy=b.id==0 and vy/mag*speed or 0,p=b.pocketed}
    end
    return r
end
local function fastStep(r)
    local balls,n=r.balls,#r.balls
    local maxv=0
    for i=1,n do local b=balls[i];if not b.p then maxv=math.max(maxv,b.vx*b.vx+b.vy*b.vy) end end
    local subs=math.clamp(math.ceil(math.sqrt(maxv)*r.dt/(r.d*.125)),1,32)
    local dt=r.dt/subs
    local d2,pr2=r.d*r.d,r.pr*r.pr
    for _=1,subs do
        for i=1,n do
            local b=balls[i]
            if b.p then continue end
            b.x+=b.vx*dt;b.y+=b.vy*dt
            local speed=math.sqrt(b.vx*b.vx+b.vy*b.vy)
            if speed>0 then
                local nextSpeed=math.max(0,speed-r.decel*dt)
                if nextSpeed<=r.rest then b.vx=0;b.vy=0
                else local scale=nextSpeed/speed;b.vx*=scale;b.vy*=scale end
            end
            for j=1,6 do
                local p=r.pockets[j];local x,y=b.x-p[1],b.y-p[2]
                if x*x+y*y<=pr2 then b.p=true;b.vx=0;b.vy=0;r.pocketed[b.id]=true;break end
            end
            if not b.p then
                if b.x>r.l then b.x=r.l;b.vx=-b.vx*r.e elseif b.x< -r.l then b.x=-r.l;b.vx=-b.vx*r.e end
                if b.y>r.w then b.y=r.w;b.vy=-b.vy*r.e elseif b.y< -r.w then b.y=-r.w;b.vy=-b.vy*r.e end
            end
        end
        for i=1,n do
            local a=balls[i];if a.p then continue end
            for j=i+1,n do
                local b=balls[j];if b.p then continue end
                local x,y=b.x-a.x,b.y-a.y
                if math.abs(x)>=r.d or math.abs(y)>=r.d then continue end
                local q=x*x+y*y
                if q>=d2 or q<=1e-10 then continue end
                local length=math.sqrt(q);local nx,ny=x/length,y/length
                local overlap=r.d-length
                local av=math.max(a.vx*nx+a.vy*ny,0)
                local bv=math.max(-b.vx*nx-b.vy*ny,0)
                local sum=av+bv
                local wa,wb=.5,.5
                if sum>1e-5 then wa=bv/sum;wb=av/sum end
                a.x-=nx*overlap*wa;a.y-=ny*overlap*wa
                b.x+=nx*overlap*wb;b.y+=ny*overlap*wb
                local approach=(a.vx-b.vx)*nx+(a.vy-b.vy)*ny
                if approach<=0 then continue end
                if not r.firstHit then
                    if a.id==0 then r.firstHit=b.id elseif b.id==0 then r.firstHit=a.id end
                end
                local impulse=approach*(1+r.e)*.5
                local ix,iy=nx*impulse,ny*impulse
                a.vx-=ix;a.vy-=iy;b.vx+=ix;b.vy+=iy
            end
        end
    end
    r.steps+=1
    local settled=true
    for i=1,n do
        local b=balls[i]
        if not b.p and b.vx*b.vx+b.vy*b.vy>r.rest*r.rest then settled=false end
        if b.id==0 then
            for j=1,6 do local p=r.pockets[j];local x,y=b.x-p[1],b.y-p[2]
                r.clearance=math.min(r.clearance,math.sqrt(x*x+y*y)-r.pr)
            end
        end
    end
    if r.pocketed[0] or (r.pocketed[8] and not r.allowed[8]) or (r.firstHit and not r.allowed[r.firstHit]) then return true end
    -- Track promising misses only after legal contact, at a reduced sampling rate.
    if r.firstHit and r.steps%8==0 then
        for _,b in ipairs(balls) do
            if not b.p and r.allowed[b.id] and b.vx*b.vx+b.vy*b.vy>r.rest*r.rest then
                for _,p in ipairs(r.pockets) do
                    local x,y=b.x-p[1],b.y-p[2]
                    r.near=math.min(r.near,x*x+y*y)
                end
            end
        end
    end
    if settled then
        if not r.firstHit or r.clearance<r.d*.04 then return true end
        local own,opponent=0,0
        for id in pairs(r.pocketed) do if r.allowed[id] then own+=1 else opponent+=1 end end
        if opponent==0 then r.result={own=own,score=own*1000+math.min(r.clearance,2)*5-r.power*.3,clearance=r.clearance} end
        return true
    end
    return r.steps>=r.limit
end

local function createSearch(frame,snap,allowed,style)
    local options=next(allowed) and candidates(frame,snap,allowed) or {}
    return {frame=frame,snap=snap,allowed=allowed,options=options,index=1,wave=1,completed=0,total=0,
        validated=0,fastCount=0,nativeCount=0,seen={},stage=1,sweep=0,style=style or "legit",
        near={},refinements={},refineIndex=1,issued=0}
end
local function makeShot(c,power,result,tests)
    return {id=c.id,dir=c.dir,power=power,kind=c.kind,cuePath=c.cuePath,objectPath=c.objectPath,
        ghost=c.ghost,target=c.target,pocket=c.pocket,score=result.score,own=result.own,verified=tests or 0,pocketed=result.pocketed}
end
local function sweepTrial(search)
    local step=search.sweep;search.sweep+=1
    -- Golden-angle ordering covers the whole table early instead of sweeping one quadrant first.
    local angle=step*2.399963229728653
    local dir=Vector3.new(math.cos(angle),0,math.sin(angle))
    local p=search.snap[1].pos
    local localDir=Vector3.new(dir:Dot(search.frame.Long),dir:Dot(search.frame.Short),0)
    return {id=0,kind="ricochet",dir=dir,cuePath={p,p+localDir},objectPath={},ghost=p+localDir,target=p,rank=0},1,0
end
local function queueRefinements(search)
    table.sort(search.near,function(a,b)return a.distance<b.distance end)
    for i=1,math.min(8,#search.near) do
        local n=search.near[i]
        for _,angle in ipairs({.15,-.15,.45,-.45,1,-1}) do
            search.refinements[#search.refinements+1]={c=n.c,power=n.power,angle=math.rad(angle)}
        end
        for _,scale in ipairs({.96,1.04,.85}) do
            search.refinements[#search.refinements+1]={c=n.c,power=math.clamp(n.power*scale,.06,1),angle=0}
        end
    end
    table.clear(search.near)
end
local function nextTrial(search)
    if not next(search.allowed) then return end
    search.issued+=1
    local options=search.options
    if search.issued%6==0 and search.refineIndex<=#search.refinements then
        local q=search.refinements[search.refineIndex];search.refineIndex+=1
        return q.c,q.power,q.angle
    end
    -- One broad full-power direction every twelve targeted trials.
    if search.issued%12==0 and search.sweep<128 then return sweepTrial(search) end
    while search.stage<=4 do
        if search.stage==1 then
            -- Every route family gets full power before low-power fallbacks.
            if search.index>math.min(24,#options) then search.index=1;search.stage=2;continue end
            local c=options[search.index];search.index+=1
            return c,1,0
        elseif search.stage==2 then
            -- Rescue straightforward pots before spending the budget on remote possibilities.
            if search.index>math.min(18,#options) then
                search.index=25;search.wave=1;search.stage=3;queueRefinements(search);continue
            end
            local c=options[search.index];search.index+=1
            return c,math.clamp(c.base*1.22,.06,1),0
        elseif search.stage==3 then
            if search.refineIndex<=#search.refinements and search.issued%3==0 then
                local q=search.refinements[search.refineIndex];search.refineIndex+=1
                return q.c,q.power,q.angle
            end
            if search.index>#options then search.index=1;search.wave+=1 end
            if search.wave>3 or #options==0 then search.stage=4;queueRefinements(search);continue end
            local c=options[search.index];search.index+=1
            local powers={1,.8,math.clamp(c.base*1.5,.06,1)}
            return c,powers[search.wave],0
        else
            if search.refineIndex<=#search.refinements then
                local q=search.refinements[search.refineIndex];search.refineIndex+=1
                return q.c,q.power,q.angle
            end
            if search.sweep<128 then return sweepTrial(search) end
            search.stage=5
        end
    end
end
local function advanceSearch(search,checkpoint)
    while not search.done do
        if not checkpoint() then return search.best end
        if not search.active then
            local proposal=search.proposal
            if proposal then
                local variants=search.style=="instant" and {{1,0}} or {{1,0},{.94,0},{1.06,0},{1,-math.rad(.2)},{1,math.rad(.2)}}
                local variant=variants[proposal.next]
                if not variant then
                    local shot=makeShot(proposal.c,proposal.power,proposal.result,proposal.next-2)
                    search.validated+=1;search.proposal=nil
                    if proposal.safety then
                        if not search.safety or shot.score>search.safety.score then search.safety=shot end
                        continue
                    end
                    if not search.best or shot.score>search.best.score then search.best=shot end
                    return search.best
                end
                search.active=rollout(search.frame,search.snap,search.allowed,proposal.c,math.clamp(proposal.power*variant[1],.06,1),variant[2])
                search.checking=true
            else
                local c,power,angle=nextTrial(search)
                if not c then search.done=true;break end
                local key=string.format("%.5f/%.5f/%.5f/%.5f",c.dir.X,c.dir.Z,power,angle)
                if search.seen[key] then continue end
                search.seen[key]=true
                search.active=fastRollout(search.frame,search.snap,search.allowed,c,power,angle)
                search.checking=false
            end
        end
        local finished
        if search.active.fast then finished=fastStep(search.active) else finished=rolloutStep(search.active) end
        if finished then
            local r=search.active
            search.active=nil;search.completed+=1
            if r.fast then
                search.fastCount+=1
                if r.result and r.result.own==0 and r.near< (r.pr+r.d*2)^2 then
                    local c=table.clone(r.c);c.dir=r.dir
                    search.near[#search.near+1]={c=c,power=r.power,distance=r.near}
                    if #search.refinements<12 and r.near<(r.pr+r.d*.5)^2 then
                        for _,angle in ipairs({.15,-.15,.45,-.45}) do
                            search.refinements[#search.refinements+1]={c=c,power=r.power,angle=math.rad(angle)}
                        end
                    end
                    if #search.near>24 then
                        table.sort(search.near,function(a,b)return a.distance<b.distance end)
                        while #search.near>12 do table.remove(search.near) end
                    end
                end
            else search.nativeCount+=1 end
            if search.checking then
                local proposal=search.proposal
                local minimum=proposal.next==1 and (proposal.safety and 0 or 1) or proposal.result.own
                if not r.result or r.result.own<minimum then search.proposal=nil
                else
                    if proposal.next==1 then proposal.result=r.result end
                    proposal.result.score=math.min(proposal.result.score,r.result.score)
                    proposal.next+=1
                end
            elseif r.result and r.result.own>0 then
                local aimed=table.clone(r.c);aimed.dir=r.dir;aimed.id=r.firstHit or r.c.id
                if aimed.kind=="safety" then aimed.kind="ricochet" end
                search.proposal={c=aimed,power=r.power,result=r.result,next=1}
            elseif r.result and r.c.kind=="safety" then
                -- Kept separately; never advertise simple contact as a verified pot.
                if not search.fallback then
                    local aimed=table.clone(r.c);aimed.dir=r.dir;aimed.id=r.firstHit or r.c.id
                    search.fallback={c=aimed,power=r.power,result=r.result,next=1,safety=true}
                end
            end
        end
    end
    return search.best
end
local function evaluate(frame,snap,allowed,c,power,checkpoint)
    local r=rollout(frame,snap,allowed,c,power)
    repeat if not checkpoint() then return end until rolloutStep(r)
    return r.result and r.result.score
end
local function choose(frame,snap,allowed,checkpoint)
    return advanceSearch(createSearch(frame,snap,allowed),checkpoint)
end
