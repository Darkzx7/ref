-- Standalone Snooker Recorder. No replay, input simulation or movement changes.
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local PPS = game:GetService("ProximityPromptService")
local Http = game:GetService("HttpService")
local player = Players.LocalPlayer
assert(player, "Run on the client")
local env = type(getgenv) == "function" and getgenv() or _G
local KEY = "__REF_SNOOKER_SCAN_V1"
local bridge = env[KEY]
if type(bridge) ~= "table" then bridge = {}; env[KEY] = bridge end
if bridge.close then pcall(bridge.close) end

local LIMIT, BUFFER_LIMIT = 3500, 32768
local records, queue, connections = {}, {}, {}
local running, alive, dropped, origin = false, true, 0, os.clock()
local tracked, lastPositions, toolConnections = {}, {}, {}
local status, refresh
local function connect(signal, fn)
    local c = signal:Connect(fn)
    connections[#connections + 1] = c
    return c
end
local function rounded(n) return math.floor(n * 1000 + 0.5) / 1000 end
local function stamp() return rounded(os.clock() - origin) end
local objectIds = setmetatable({}, {__mode="k"})
local nextObjectId = 0
local function objectId(obj)
    if not objectIds[obj] then nextObjectId += 1; objectIds[obj] = nextObjectId end
    return objectIds[obj]
end
local function pathOf(obj)
    local parts, at = {}, obj
    for _ = 1, 64 do
        if not at or at == game then break end
        table.insert(parts, 1, at.Name)
        at = at.Parent
    end
    local result = {type="Instance", id=objectId(obj), class=obj.ClassName, path=table.concat(parts,"."), parts=parts}
    local at = obj
    while at and at ~= workspace do
        if at.Parent and at.Parent.Name == "Snookers" then
            result.tableId = objectId(at)
            break
        end
        at = at.Parent
    end
    return result
end
local function xyz(v) return { rounded(v.X), rounded(v.Y), rounded(v.Z) } end
local function encode(value, depth, seen)
    depth, seen = depth or 0, seen or {}
    local kind = typeof(value)
    if kind == "nil" then return {type = "nil"} end
    if kind == "boolean" or kind == "string" then return value end
    if kind == "number" then
        if value ~= value or math.abs(value) == math.huge then return tostring(value) end
        return value
    end
    if kind == "Instance" then return pathOf(value) end
    if kind == "Vector3" then return {type=kind, value=xyz(value)} end
    if kind == "Vector2" then return {type=kind, value={value.X,value.Y}} end
    if kind == "CFrame" then return {type=kind, value={value:GetComponents()}} end
    if kind == "Color3" then return {type=kind, value={value.R,value.G,value.B}} end
    if kind == "EnumItem" then return {type=kind, value=tostring(value)} end
    if kind ~= "table" then return {type=kind, value=tostring(value)} end
    if value.__snookerBuffer then
        local hex = value.bytes:gsub(".", function(c) return string.format("%02x", string.byte(c)) end)
        return {type="buffer", length=value.length, hex=hex, truncated=#value.bytes < value.length}
    end
    if seen[value] then return {type="reference"} end
    if depth > 7 then return {type="table", truncated=true} end
    seen[value] = true
    local entries = {}
    for k,v in pairs(value) do
        entries[#entries+1] = {key=encode(k,depth+1,seen), value=encode(v,depth+1,seen)}
    end
    return {type="table", entries=entries}
end
-- Copy reusable BLINK buffers before forwarding the call. No yields inside the hook.
local function snapshot(value, depth, seen, budget)
    local kind = typeof(value)
    if kind == "buffer" then
        local length = buffer.len(value)
        return {__snookerBuffer=true, length=length, bytes=buffer.readstring(value,0,math.min(length,BUFFER_LIMIT))}
    end
    if kind ~= "table" then return value end
    if seen[value] then return seen[value] end
    if depth >= 5 then return {truncated=true} end
    local copy = {}; seen[value] = copy
    for k,v in pairs(value) do
        budget.n += 1
        if budget.n > 300 then copy.__truncated = true; break end
        copy[k] = snapshot(v,depth+1,seen,budget)
    end
    return copy
end
local function enqueue(kind, data)
    if not running or not alive then return end
    if #queue >= 250 then dropped += 1; return end
    queue[#queue+1] = {t=stamp(), kind=kind, data=data}
end
local function drain()
    local batch = queue; queue = {}
    for _, row in ipairs(batch) do
        if #records >= LIMIT then
            dropped += 1; running = false
        else
            local ok, data = pcall(encode,row.data)
            records[#records+1] = {t=row.t, kind=row.kind, data=ok and data or {error=tostring(data)}}
        end
    end
end
local function useful(remote, args)
    if type(args[1]) == "string" and args[1]:lower():find("snooker",1,true) then return true end
    if remote.Name:find("BLINK",1,true) then return true end
    return remote.Name:lower():find("snooker",1,true) ~= nil
end
local lastAim = setmetatable({}, {__mode="k"})
local sink = function(remote, method, ...)
    if not running or not alive then return end
    if #queue >= 250 then dropped += 1; return end
    local args = table.pack(...)
    if not useful(remote,args) then return end
    if args[1] == "SnookerAim" and typeof(args[2]) == "Instance" then
        local now = os.clock()
        if now - (lastAim[args[2]] or 0) < 0.25 then return end
        lastAim[args[2]] = now
    end
    enqueue("remote", {remote=remote, method=method, n=args.n,
        args=snapshot(args,0,{}, {n=0})})
end
bridge.sink = sink
local hookAvailable = bridge.installed == true
if not hookAvailable and type(hookmetamethod) == "function" and type(getnamecallmethod) == "function" then
    local ok, err = pcall(function()
        local old
        local handler = function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" or method == "InvokeServer" then
                local callback = bridge.sink
                if callback then pcall(callback,self,method,...) end
            end
            return old(self,...)
        end
        old = hookmetamethod(game,"__namecall",type(newcclosure)=="function" and newcclosure(handler) or handler)
        bridge.installed = true
    end)
    hookAvailable = ok and bridge.installed == true
    bridge.error = not ok and tostring(err) or nil
end

local function relevant(obj)
    local at = obj
    for _ = 1, 9 do
        if not at or at == workspace then break end
        local name = at.Name:lower()
        if name:find("snooker",1,true) or name:find("billiard",1,true)
            or name:find("sinuca",1,true) or name:find("bilhar",1,true)
            or name:find("pooltable",1,true) or name:find("pool table",1,true) then return true end
        at = at.Parent
    end
    return false
end
local function track(obj)
    if #tracked >= 250 or not obj:IsA("BasePart") or not relevant(obj) then return end
    if not table.find(tracked,obj) then tracked[#tracked+1] = obj end
end
local function sample(full)
    local parts = {}
    for i = #tracked, 1, -1 do
        local part = tracked[i]
        if not part.Parent then table.remove(tracked,i); lastPositions[part]=nil
        else
            local pos = part.Position
            if full or not lastPositions[part] or (pos-lastPositions[part]).Magnitude > 0.05 then
                lastPositions[part] = pos
                parts[#parts+1] = {object=part, position=pos, velocity=part.AssemblyLinearVelocity,
                    size=full and part.Size or nil, color=full and part.Color or nil,
                    cframe=full and part.CFrame or nil}
            end
        end
    end
    if #parts > 0 then enqueue("table state",parts) end
end
-- Receive copies of server events without replacing existing callbacks.
local incomingSeen = setmetatable({}, {__mode="k"})
local Replicated = game:GetService("ReplicatedStorage")
local function watchRemote(obj)
    if incomingSeen[obj] or not (obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent")) then return end
    if obj.Name ~= "RemoteEvent" and obj.Name ~= "UnreliableRemoteEvent"
        and not obj.Name:find("BLINK",1,true) and not obj.Name:lower():find("snooker",1,true) then return end
    incomingSeen[obj] = true
    connect(obj.OnClientEvent,function(...)
        if not running or not alive then return end
        local args=table.pack(...)
        if not useful(obj,args) and obj.Name ~= "RemoteEvent" then return end
        pcall(function() enqueue("incoming",{remote=obj,n=args.n,args=snapshot(args,0,{}, {n=0})}) end)
    end)
end
for _,obj in ipairs(Replicated:GetDescendants()) do watchRemote(obj) end
connect(Replicated.DescendantAdded,watchRemote)

local metadataSeen = setmetatable({}, {__mode="k"})
local function describe(obj)
    local entry={object=obj,attributes=obj:GetAttributes()}
    if obj:IsA("Model") then entry.pivot=obj:GetPivot() end
    if obj:IsA("BasePart") then entry.cframe=obj.CFrame; entry.size=obj.Size end
    if obj:IsA("ValueBase") then pcall(function() entry.value=obj.Value end) end
    return entry
end
local function watchMetadata(obj)
    if metadataSeen[obj] then return end
    metadataSeen[obj]=true
    connect(obj.AttributeChanged,function(name)
        enqueue("attribute",{object=obj,name=name,value=obj:GetAttribute(name)})
    end)
    if obj:IsA("ValueBase") then
        connect(obj.Changed,function(value) enqueue("value",{object=obj,value=value}) end)
    end
end
local function captureMetadata()
    local tables=workspace:FindFirstChild("Snookers")
    if tables then
        local objects={tables}
        for _,obj in ipairs(tables:GetDescendants()) do objects[#objects+1]=obj end
        for i,obj in ipairs(objects) do
            if not alive or not running then return end
            watchMetadata(obj)
            enqueue("table object",describe(obj))
            if i%40==0 then task.wait(0.16) end
        end
    end
    watchMetadata(player)
    enqueue("player state",describe(player))
    local modules={}
    for _,obj in ipairs(Replicated:GetDescendants()) do
        if obj:IsA("ModuleScript") and relevant(obj) then modules[#modules+1]=obj end
    end
    enqueue("module paths",modules)
end
if workspace:FindFirstChild("Snookers") then
    connect(workspace.Snookers.DescendantAdded,function(obj)
        watchMetadata(obj)
        enqueue("table object",describe(obj))
    end)
end
local lastUI=""
local function sampleUI(ignoredGui)
    local list={}
    local pg=player:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    for _,obj in ipairs(pg:GetDescendants()) do
        if not obj:IsDescendantOf(ignoredGui) and relevant(obj) and (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("Frame") or obj:IsA("ScreenGui")) then
            local row={object=pathOf(obj)}
            if obj:IsA("GuiObject") then row.visible=obj.Visible end
            if obj:IsA("ScreenGui") then row.enabled=obj.Enabled end
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then row.text=obj.Text end
            row.attributes=obj:GetAttributes()
            list[#list+1]=row
            if #list>=120 then break end
        end
    end
    local ok,key=pcall(function() return Http:JSONEncode(encode(list)) end)
    if ok and key~=lastUI then lastUI=key; enqueue("snooker ui",list) end
end
local function context()
    local camera = workspace.CurrentCamera
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    return {camera=camera and camera.CFrame, character=root and root.CFrame}
end
local function watchTool(obj)
    if not obj:IsA("Tool") or toolConnections[obj] then return end
    toolConnections[obj] = true
    connect(obj.Equipped,function() enqueue("tool equipped",{tool=obj}) end)
    connect(obj.Activated,function() enqueue("tool activated",{tool=obj, view=context()}) end)
    connect(obj.Deactivated,function() enqueue("tool released",{tool=obj, view=context()}) end)
end
local function watchContainer(container)
    for _, obj in ipairs(container:GetDescendants()) do watchTool(obj) end
    connect(container.DescendantAdded,watchTool)
end
local backpack = player:FindFirstChildOfClass("Backpack")
if backpack then watchContainer(backpack) end
if player.Character then watchContainer(player.Character) end
connect(player.CharacterAdded,function(character)
    watchContainer(character); enqueue("respawn",{})
end)
connect(workspace.DescendantAdded,track)
connect(PPS.PromptTriggered,function(prompt,who)
    if who == nil or who == player then enqueue("prompt",{object=prompt, action=prompt.ActionText, view=context()}) end
end)
local function inputEvent(kind,input,processed)
    if processed or UIS:GetFocusedTextBox() then return end
    local key, inputType = input.KeyCode, input.UserInputType
    if inputType ~= Enum.UserInputType.Touch and inputType ~= Enum.UserInputType.MouseButton1
        and inputType ~= Enum.UserInputType.MouseButton2 and key ~= Enum.KeyCode.E
        and key ~= Enum.KeyCode.Space then return end
    enqueue(kind,{key=key,inputType=inputType,position=input.Position,view=context()})
end
connect(UIS.InputBegan,function(input,p) inputEvent("input began",input,p) end)
connect(UIS.InputEnded,function(input,p) inputEvent("input ended",input,p) end)

local gui = Instance.new("ScreenGui")
gui.Name="SnookerRecorder2"; gui.ResetOnSpawn=false; gui.DisplayOrder=999
gui.Parent=player:WaitForChild("PlayerGui")
local function create(class,props,parent)
    local obj=Instance.new(class)
    for k,v in pairs(props) do obj[k]=v end
    obj.Parent=parent
    return obj
end
local function round(obj,r) create("UICorner",{CornerRadius=UDim.new(0,r)},obj) end
local frame=create("Frame",{Size=UDim2.fromOffset(310,194),Position=UDim2.new(0.5,-155,0.25,0),
    BackgroundColor3=Color3.fromRGB(20,21,24),BorderSizePixel=0},gui)
round(frame,10)
create("UIStroke",{Color=Color3.fromRGB(65,68,74),Transparency=0.3},frame)
local title=create("TextLabel",{Size=UDim2.new(1,-90,0,36),Position=UDim2.fromOffset(12,0),
    Text="snooker recorder 2",TextSize=14,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left,
    TextColor3=Color3.fromRGB(235,237,240),BackgroundTransparency=1,Active=true},frame)
local body=create("Frame",{Position=UDim2.fromOffset(12,42),Size=UDim2.new(1,-24,1,-48),BackgroundTransparency=1},frame)
local label=create("TextLabel",{Size=UDim2.new(1,0,0,42),BackgroundTransparency=1,TextWrapped=true,
    TextSize=11,Font=Enum.Font.Gotham,TextColor3=Color3.fromRGB(180,185,195),TextXAlignment=Enum.TextXAlignment.Left},body)
local function button(text,x,y,w,parent)
    local b=create("TextButton",{Text=text,Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,34),
        BackgroundColor3=Color3.fromRGB(38,40,45),TextColor3=Color3.fromRGB(235,237,240),
        BorderSizePixel=0,TextSize=12,Font=Enum.Font.GothamMedium,AutoButtonColor=true},parent or body)
    round(b,6); return b
end
local start=button("start",0,51,139)
local mark=button("mark shot",147,51,139)
local copy=button("copy",0,94,139)
local save=button("save",147,94,139)
local minimize=button("-",234,3,32,frame)
local close=button("x",272,3,30,frame)
local note="ready"
refresh=function()
    if not alive then return end
    label.Text=string.format("%s | %d records | %d parts\n%s",running and "recording" or "paused",#records,#tracked,note)
    start.Text=running and "stop" or "start"
end
local function report(text) note=text; refresh() end
local function export()
    drain()
    return Http:JSONEncode({version="Snooker recorder 2",place=game.PlaceId,exported=os.date("!%Y-%m-%dT%H:%M:%SZ"),
        outgoingHook=hookAvailable,dropped=dropped,records=records,
        note="Outgoing calls plus filtered server events. Instance IDs distinguish same-named tables in this session. Aim samples throttled to 4Hz. Direct/cached calls may be missed. No replay or server-success inference."})
end
connect(start.Activated,function()
    if running then sample(true); running=false; drain(); report("stopped"); return end
    if #records >= LIMIT then report("log full - save and re-run"); return end
    running=true
    if #records==0 then origin=os.clock() end
    report("finding table...")
    task.spawn(function()
        for i,obj in ipairs(workspace:GetDescendants()) do
            if not alive or not running then return end
            track(obj)
            if i%300==0 then task.wait() end
        end
        sample(true); enqueue("started",context()); captureMetadata(); sampleUI(gui)
        report(hookAvailable and "manual actions only" or "executor has no remote hook")
    end)
end)
connect(mark.Activated,function() enqueue("shot marker",context()); sample(true); report("shot marked") end)
connect(copy.Activated,function()
    local clipboard=setclipboard or toclipboard
    if type(clipboard)~="function" then report("clipboard unavailable; use save"); return end
    local ok,err=pcall(function() clipboard(export()) end)
    report(ok and "copied" or tostring(err):sub(1,90))
end)
connect(save.Activated,function()
    if type(writefile)~="function" then report("writefile unavailable; use copy"); return end
    local name="snooker_"..os.date("%Y%m%d_%H%M%S").."_"..math.floor(os.clock()*1000)..".json"
    local folder=""
    if type(makefolder)=="function" then
        for _,dir in ipairs({"True Ref","True Ref/Scans","True Ref/Scans/snooker"}) do pcall(makefolder,dir) end
        if type(isfolder)=="function" and isfolder("True Ref/Scans/snooker") then folder="True Ref/Scans/snooker/" end
    end
    local ok,err=pcall(function() writefile(folder..name,export()) end)
    report(ok and ("saved: "..folder..name) or tostring(err):sub(1,90))
end)
local small=false
connect(minimize.Activated,function()
    small=not small; body.Visible=not small
    frame.Size=UDim2.fromOffset(310,small and 38 or 194)
    minimize.Text=small and "+" or "-"
end)
local drag, dragStart, frameStart
connect(title.InputBegan,function(input)
    if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
        drag=input; dragStart=input.Position; frameStart=frame.Position
    end
end)
connect(UIS.InputChanged,function(input)
    if not drag then return end
    if drag.UserInputType==Enum.UserInputType.Touch and input~=drag then return end
    if drag.UserInputType~=Enum.UserInputType.Touch and input.UserInputType~=Enum.UserInputType.MouseMovement then return end
    local delta=input.Position-dragStart
    frame.Position=UDim2.new(frameStart.X.Scale,frameStart.X.Offset+delta.X,frameStart.Y.Scale,frameStart.Y.Offset+delta.Y)
end)
connect(UIS.InputEnded,function(input) if input==drag then drag=nil end end)
local function shutdown()
    if not alive then return end
    running=false; alive=false
    if bridge.sink==sink then bridge.sink=nil end
    for _,c in ipairs(connections) do c:Disconnect() end
    gui:Destroy()
end
bridge.close=shutdown
connect(close.Activated,shutdown)
connect(gui.Destroying,shutdown)
refresh()
task.spawn(function()
    local lastSample, lastUISample=0,0
    while alive do
        task.wait(0.15)
        if running and os.clock()-lastSample>=0.4 then lastSample=os.clock(); sample(false) end
        if running and os.clock()-lastUISample>=0.8 then
            lastUISample=os.clock(); pcall(sampleUI,gui)
        end
        drain()
        if #records>=LIMIT then note="log full - copy or save" end
        refresh()
    end
end)
