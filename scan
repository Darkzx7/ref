local function path(object)
    local ok, result = pcall(function()
        return object:GetFullName()
    end)
    return ok and result or "<removed instance>"
end

local function serialize(value, depth, seen)
    local kind = typeof(value)

    if kind == "Instance" then
        return path(value)
    elseif kind == "string" then
        return string.format("%q", value:sub(1, 160))
            .. (#value > 160 and "…" or "")
    elseif kind == "table" then
        if seen[value] then return "<cycle>" end
        if depth >= 2 then return "{…}" end

        seen[value] = true
        local parts, count = {}, 0

        for k, v in next, value do
            count += 1
            if count > 8 then
                parts[#parts + 1] = "…"
                break
            end
            parts[#parts + 1] = serialize(k, depth + 1, seen)
                .. "=" .. serialize(v, depth + 1, seen)
        end

        seen[value] = nil
        return "{" .. table.concat(parts, ", ") .. "}"
    end

    return tostring(value):sub(1, 200)
end

local function arguments(...)
    local parts, count = {}, select("#", ...)

    for i = 1, math.min(count, 10) do
        parts[i] = serialize(select(i, ...), 0, {})
    end

    if count > 10 then parts[#parts + 1] = "…" end
    return table.concat(parts, ", ")
end

local Monitor = {}
Monitor.__index = Monitor

function Monitor.new()
    return setmetatable({
        alive = true,
        paused = false,
        lines = {},
        first = 1,
        count = 0,
        total = 0,
        dropped = 0,
        windowStart = os.clock(),
        windowCount = 0,
        started = os.clock(),
        dirty = true,
    }, Monitor)
end

function Monitor:Add(kind, target, ...)
    if not self.alive or self.paused then return end

    local now = os.clock()
    if now - self.windowStart >= 1 then
        self.windowStart, self.windowCount = now, 0
    end

    if self.windowCount >= CONFIG.PerSecond then
        self.dropped += 1
        self.dirty = true
        return
    end

    self.windowCount += 1

    local ok, info = pcall(arguments, ...)
    if not ok then info = "<arguments unavailable>" end

    local name = typeof(target) == "Instance"
        and path(target) or tostring(target)

    local line = string.format(
        "[%07.2fs] %-9s %s%s",
        now - self.started,
        kind,
        name,
        info ~= "" and " | " .. info or ""
    )

    local index = (self.first + self.count - 1) % CONFIG.MaxLogs + 1
    self.lines[index] = line:sub(1, 1800)

    if self.count == CONFIG.MaxLogs then
        self.first = self.first % CONFIG.MaxLogs + 1
    else
        self.count += 1
    end

    self.total += 1
    self.dirty = true
end

function Monitor:Entries(limit)
    local entries = {}

    for offset = math.max(0, self.count - (limit or self.count)), self.count - 1 do
        entries[#entries + 1] =
            self.lines[(self.first + offset - 1) % CONFIG.MaxLogs + 1]
    end

    return entries
end

function Monitor:Export()
    return string.format(
        "Client interaction monitor | place=%s | outgoing=%s\n"
        .. "Retained=%d / recorded=%d | rate-limited=%d\n"
        .. "CALL=request only; OBS=observed; MOVE=sudden displacement, "
        .. "cause unknown. Arguments may be truncated.\n\n",
        tostring(game.PlaceId),
        self.outgoing or "unavailable",
        self.count,
        self.total,
        self.dropped
    ) .. table.concat(self:Entries(), "\n")
end

function Monitor:Clear()
    self.lines, self.first, self.count = {}, 1, 0
    self.total, self.dropped = 0, 0
    self.windowCount, self.windowStart = 0, os.clock()
    self.dirty = true
end

