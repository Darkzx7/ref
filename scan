local CONFIG = { Delay = 0.08, Timeout = 4, ScanInterval = 6, PageSize = 60, MaxLogs = 200 }
-- Optional project-specific calls, keyed by GetFullName(). Resolved on each run.
-- Example: ["ReplicatedStorage.Remotes.Test"] = function(object, args) object:FireServer(table.unpack(args, 1, args.n)) end
local CUSTOM_HANDLERS = {}

-- BEGIN TESTER CORE
local Tester = {}
Tester.__index = Tester
local kinds = {
    RemoteEvent = "remote", UnreliableRemoteEvent = "remote", RemoteFunction = "remote",
    BindableEvent = "local", BindableFunction = "local", Tool = "local",
    Sound = "local", Animation = "local", ProximityPrompt = "local",
    ClickDetector = "inspect", TouchTransmitter = "inspect", ModuleScript = "inspect",
}
function Tester.new()
    return setmetatable({ alive = true, busy = false, scanning = false, items = {}, tracks = {}, drafts = {} }, Tester)
end
function Tester:ReleasePrompt()
    local prompt = self.prompt
    self.prompt = nil
    if prompt then pcall(function() prompt:InputHoldEnd() end) end
end
function Tester:Stop()
    self.cancelled = true
    if self.worker then pcall(task.cancel, self.worker); self.worker = nil end
    self:ReleasePrompt()
end
function Tester:Destroy()
    self.alive = false
    self:Stop()
    for track in pairs(self.tracks) do
        pcall(function() track:Stop(0); track:Destroy() end)
    end
    table.clear(self.tracks)
end
function Tester.Rig(object)
    local current = object
    for _ = 1, 8 do
        if not current then break end
        if current:IsA("Model") then
            local humanoid = current:FindFirstChildOfClass("Humanoid")
            if humanoid then return humanoid.RigType == Enum.HumanoidRigType.R15 and "R15" or "R6" end
        end
        local name = string.lower(current.Name)
        if name:find("r15", 1, true) then return "R15" end
        if name:find("r6", 1, true) then return "R6" end
        current = current.Parent
    end
    return "ANY"
end
function Tester:Scan(roots)
    if not self.alive or self.busy or self.scanning then return false end
    self.scanning = true
    local items, seen, visited = {}, {}, 0
    local ok, err = pcall(function()
        for _, root in ipairs(roots) do
            for _, object in ipairs(root:GetDescendants()) do
                if not self.alive then return end
                if not seen[object] then
                    seen[object] = true
                    local kind = kinds[object.ClassName]
                    if kind and object.Parent then
                        table.insert(items, { ref = object, path = object:GetFullName(), class = object.ClassName,
                            kind = kind, rig = Tester.Rig(object) })
                    end
                    visited += 1
                    if visited % 300 == 0 then task.wait() end
                end
            end
        end
        local order = { R15 = 1, R6 = 2, ANY = 3 }
        table.sort(items, function(a, b)
            if order[a.rig] ~= order[b.rig] then return order[a.rig] < order[b.rig] end
            return a.path < b.path
        end)
    end)
    self.scanning = false
    if not self.alive then return false, "Closed" end
    if not ok then return false, tostring(err) end
    self.items = items
    for object in pairs(self.drafts) do if not seen[object] then self.drafts[object] = nil end end
    return true, #items
end
function Tester.Decode(text)
    assert(text:match("^%s*%["), "Arguments must be a JSON array, e.g. [true, 1]")
    local args = HttpService:JSONDecode(text)
    assert(type(args) == "table", "Arguments must be an array")
    -- JSON null is not a reliable Lua array slot; use {"$nil":true} instead.
    -- Check null lexically below, without rejecting a string containing "null".
    local inString, escaped, outside = false, false, {}
    for i = 1, #text do
        local c = text:sub(i, i)
        if inString then
            if escaped then escaped = false elseif c == "\\" then escaped = true elseif c == '"' then inString = false end
        elseif c == '"' then inString = true
        else table.insert(outside, c) end
    end
    assert(not table.concat(outside):find("null", 1, true), 'Use {"$nil":true} instead of null')
    return args
end
function Tester.Resolve(args)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local function resolve(value, depth)
        assert(depth < 20, "Arguments are nested too deeply")
        if type(value) == "string" then
            if value:sub(1, 2) == "$$" then return value:sub(2) end
            if value == "$player" then return LocalPlayer end
            if value == "$character" then assert(character, "Character unavailable"); return character end
            if value == "$root" then assert(root, "Root part unavailable"); return root end
            if value == "$position" then assert(root, "Root part unavailable"); return root.Position end
        elseif type(value) == "table" then
            if value["$nil"] == true then return nil end
            local copy = {}
            for k, v in pairs(value) do copy[k] = resolve(v, depth + 1) end
            return copy
        end
        return value
    end
    local resolved = { n = #args }
    for i = 1, #args do resolved[i] = resolve(args[i], 0) end
    return resolved
end
function Tester:Dispatch(item, args)
    local object, class = item.ref, item.class
    if not object.Parent then return "skipped", "Object was removed" end
    local custom = CUSTOM_HANDLERS[item.path]
    if custom then return "returned", tostring(custom(object, args)) end
    if class == "RemoteEvent" or class == "UnreliableRemoteEvent" then
        object:FireServer(table.unpack(args, 1, args.n))
        return "sent", "Sent; server outcome is unconfirmed"
    elseif class == "RemoteFunction" or class == "BindableFunction" then
        local result
        if class == "RemoteFunction" then result = table.pack(object:InvokeServer(table.unpack(args, 1, args.n)))
        else result = table.pack(object:Invoke(table.unpack(args, 1, args.n))) end
        local values = {}
        for i = 1, math.min(result.n, 4) do values[i] = tostring(result[i]):sub(1, 100) end
        return "returned", result.n == 0 and "No return values" or table.concat(values, " | ")
    elseif class == "BindableEvent" then
        object:Fire(table.unpack(args, 1, args.n))
        return "sent", "Local event dispatched; listeners are unconfirmed"
    elseif class == "Tool" then
        if object.Parent ~= LocalPlayer.Character then return "skipped", "Equip this tool first" end
        if not object.Enabled then return "skipped", "Tool is disabled" end
        object:Activate()
        return "sent", "Tool activation requested"
    elseif class == "Sound" then
        object:Play()
        return "local", "Local playback requested"
    elseif class == "Animation" then
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
        if not animator or humanoid.Health <= 0 then return "skipped", "No living character animator" end
        local track = animator:LoadAnimation(object)
        self.tracks[track] = true
        track.Ended:Once(function()
            if self.tracks[track] then self.tracks[track] = nil; track:Destroy() end
        end)
        track:Play()
        return "local", "Animation playback requested"
    elseif class == "ProximityPrompt" then
        if not object.Enabled then return "skipped", "Prompt is disabled" end
        local parent = object.Parent
        local position
        if parent:IsA("Attachment") then position = parent.WorldPosition
        elseif parent:IsA("BasePart") then position = parent.Position
        elseif parent:IsA("Model") then position = parent:GetPivot().Position end
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not position or not root then return "skipped", "Prompt or character position unavailable" end
        if (position - root.Position).Magnitude > object.MaxActivationDistance then return "skipped", "Move closer to this prompt" end
        if object.HoldDuration + 0.1 >= CONFIG.Timeout then return "skipped", "Hold duration exceeds the call timeout" end
        self.prompt = object
        object:InputHoldBegin()
        task.wait(object.HoldDuration + 0.05)
        self:ReleasePrompt()
        return "sent", "Prompt input sent; activation is unconfirmed"
    elseif class == "ModuleScript" then
        return "skipped", "Module needs an explicit CUSTOM_HANDLERS entry"
    elseif class == "ClickDetector" then
        return "skipped", "MouseClick is a signal; use a real click or a project handler"
    elseif class == "TouchTransmitter" then
        return "skipped", "Touch requires physical contact or a project handler"
    end
    return "skipped", "Unsupported type"
end
function Tester:Run(queue, onResult, onDone)
    if not self.alive or self.busy or self.scanning or #queue == 0 then return false end
    self.busy, self.cancelled = true, false
    local snapshot = table.clone(queue)
    task.spawn(function()
        local counts = { sent = 0, returned = 0, ["local"] = 0, error = 0, timeout = 0, skipped = 0 }
        for index, job in ipairs(snapshot) do
            if not self.alive or self.cancelled then break end
            local finished, result = false, nil
            local started = os.clock()
            self.worker = task.spawn(function()
                result = table.pack(pcall(function()
                    return self:Dispatch(job.item, Tester.Resolve(Tester.Decode(job.json)))
                end))
                finished = true
            end)
            while not finished and self.alive and not self.cancelled and os.clock() - started < CONFIG.Timeout do task.wait(0.03) end
            if not finished and self.worker then pcall(task.cancel, self.worker) end
            self.worker = nil
            self:ReleasePrompt()
            if not self.alive or self.cancelled then break end
            local status, detail
            if not finished then status, detail = "timeout", "No result within " .. CONFIG.Timeout .. "s; an already sent request cannot be recalled"
            elseif not result[1] then status, detail = "error", tostring(result[2])
            else status, detail = result[2], result[3] end
            counts[status] += 1
            onResult(job.item, status, tostring(detail):sub(1, 400), index, #snapshot, counts)
            if index < #snapshot then task.wait(CONFIG.Delay) end
        end
        self.busy = false
        if self.alive then onDone(self.cancelled, counts) end
    end)
    return true
end
