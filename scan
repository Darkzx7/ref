local function ownTable()
    local folder=workspace:FindFirstChild("Snookers")
    if not folder then return end
    local found
    for _,t in ipairs(folder:GetChildren()) do
        if t:GetAttribute("Team1Id")==player.UserId or t:GetAttribute("Team2Id")==player.UserId then
            if found then return nil,"multiple active tables" end
            found=t
        end
    end
    return found
end
local function placing(t)
    -- Client.Start closes over the native per-table placement map.
    for _,value in pairs(ups(Client.Start)) do
        if type(value)=="table" and rawget(value,t)==true then return true end
    end
    return false
end
local lastSubmission
local pendingResult
local function canPlay(t)
    if not t or not t.Parent then return false,"join a table" end
    if t:GetAttribute("ShooterId")~=player.UserId then return false,"waiting for your turn" end
    if simulations[t] or t:GetAttribute("SnookerBusy") then return false,"balls in motion" end
    if placing(t) then return false,"place the white ball using the game controls" end
    local balls=t:FindFirstChild("Balls")
    local white=balls and balls:FindFirstChild("White")
    if not white or white:GetAttribute("Pocketed") then return false,"place the white ball using the game controls" end
    local ends=t:GetAttribute("TurnEnds")
    if type(ends)~="number" or workspace:GetServerTimeNow()>=ends-.25 then return false,"waiting for turn state" end
    if lastSubmission and lastSubmission.table==t and lastSubmission.turn==ends then
        return false,"waiting for shot confirmation"
    end
    return true
end
local function capture(t)
    local diameter=RS.Assets.Snooker.Ball:GetExtentsSize().X
    local frameData=Physics.BuildFrame(t,diameter)
    assert(frameData and diameter>0,"invalid table geometry")
    local snap={}
    for _,model in ipairs(t.Balls:GetChildren()) do
        if not model:IsA("Model") then continue end
        local id=model:GetAttribute("BallId")
        local part=model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
        if type(id)=="number" and part then
            snap[#snap+1]={id=id,pos=Physics.WorldToLocal(frameData,part.Position),world=part.Position,
                model=model,part=part,pocketed=model:GetAttribute("Pocketed")==true}
        end
    end
    table.sort(snap,function(a,b) return a.id<b.id end)
    assert(#snap>1 and snap[1].id==0,"ball state unavailable")
    return frameData,snap
end
local function unchanged(snap)
    for _,b in ipairs(snap) do
        if not b.model.Parent or not b.part.Parent or (b.part.Position-b.world).Magnitude>.0005
            or (b.model:GetAttribute("Pocketed")==true)~=b.pocketed then return false end
    end
    return true
end
local function drawLine(part,a,b)
    local len=(b-a).Magnitude
    if len<.005 then part.Transparency=1;return end
    part.Size=Vector3.new(.025,.025,len)
    part.CFrame=CFrame.lookAt((a+b)*.5,b);part.Transparency=.25
end
local routeLines={}
local function clearRoutes()
    for _,part in ipairs(routeLines) do if part.Parent then part.Transparency=1 end end
end
local oldHide=hidePreview
hidePreview=function() clearRoutes();oldHide() end
local function previewAim(frameData,snap,shot,dir)
    local from=Physics.LocalToWorld(frameData,snap[1].pos)+Vector3.new(0,.12,0)
    local path=shot.cuePath or {snap[1].pos,shot.ghost}
    local distance=(path[2]-path[1]).Magnitude
    drawLine(aimLine,from,from+dir*distance)
    targetLine.Transparency=1
    clearRoutes()
    local index=0
    local function segment(a,b)
        index+=1
        if not routeLines[index] then routeLines[index]=line() end
        drawLine(routeLines[index],Physics.LocalToWorld(frameData,a)+Vector3.new(0,.12,0),Physics.LocalToWorld(frameData,b)+Vector3.new(0,.12,0))
    end
    for i=2,#path-1 do segment(path[i],path[i+1]) end
    for i=1,#(shot.objectPath or {})-1 do segment(shot.objectPath[i],shot.objectPath[i+1]) end
    if pointerFn and type(setup)=="function" and workspace.CurrentCamera then
        local p,visible=workspace.CurrentCamera:WorldToScreenPoint(from-Vector3.new(0,.12,0)+dir*math.max(distance,1))
        if visible then
            if not pointerOwned then pointerBefore=ups(pointerFn)[1];pointerOwned=true end
            pcall(setup,pointerFn,1,Vector2.new(p.X,p.Y))
        end
    end
end
local cachedSearch
local function turn(t,token)
    local turnEnd=t:GetAttribute("TurnEnds")
    local team=t:GetAttribute("Team1Id")==player.UserId and 1 or 2
    local solids=t:GetAttribute("SolidsTeam")
    local cache=cachedSearch
    if not cache or cache.table~=t or cache.turn~=turnEnd or cache.solids~=solids or cache.style~=mode or not unchanged(cache.snap) then
        local created=os.clock()
        local frameData,snap=capture(t)
        cache={started=created,epoch=token,table=t,turn=turnEnd,solids=solids,style=mode,frame=frameData,snap=snap,
            search=createSearch(frameData,snap,legalTargets(snap,team,solids),mode)}
        cachedSearch=cache
    end
    if cache.epoch~=token then cache.epoch=token;cache.started=os.clock();cache.exhausted=false end
    if cache.exhausted then say("no confirmed pot within search budget — waiting for a new layout");return end
    local frameData,snap=cache.frame,cache.snap
    if cache.search.done and not cache.search.best and not cache.search.safety then
        say("no safe route in this layout");return
    end
    local function valid()
        return alive and enabled and epoch==token and t.Parent
            and t:GetAttribute("TurnEnds")==turnEnd and t:GetAttribute("SolidsTeam")==solids
            and canPlay(t) and unchanged(snap)
    end
    local available=turnEnd-workspace:GetServerTimeNow()-(mode=="legit" and aimTime or 0)-.75
    if available<.2 then say("not enough time left for this turn");return end
    local cap=mode=="instant" and 2 or 7
    local elapsed=os.clock()-cache.started
    local grace=cache.search.proposal and .8 or 0
    local remaining=math.min(available,math.max(0,cap+grace-elapsed))
    local deadline=os.clock()+remaining
    local lastYield=os.clock()
    local function checkpoint()
        if os.clock()>=deadline or not alive or not enabled or epoch~=token then return false end
        if os.clock()-lastYield>.014 then
            task.wait();lastYield=os.clock()
            if not valid() then return false end
        end
        return true
    end
    say(string.format("search | %d fast / %d native",cache.search.fastCount,cache.search.nativeCount))
    local shot=cache.search.best
    if remaining>0 then shot=advanceSearch(cache.search,checkpoint) end
    -- Only validate a recovery contact after the pot search budget, not before it.
    if not shot and cache.search.fallback and not cache.search.proposal
        and (os.clock()-cache.started>=cap or cache.search.done) then
        cache.search.proposal=cache.search.fallback;cache.search.fallback=nil;cache.search.done=false
        deadline=os.clock()+math.min(.8,math.max(0,turnEnd-workspace:GetServerTimeNow()-.5))
        shot=advanceSearch(cache.search,checkpoint)
    end
    if not shot and cache.search.safety and (os.clock()-cache.started>=cap+(cache.search.proposal and .8 or 0) or cache.search.done or turnEnd-workspace:GetServerTimeNow()<(mode=="legit" and aimTime or 0)+3.8) then
        shot=cache.search.safety
    end
    if not valid() then hidePreview();return end
    if not shot then
        if os.clock()-cache.started>=cap+(cache.search.proposal and .8 or 0) then
            cache.exhausted=true
            say("search limit — no confirmed shot; use manual play")
            return
        end
        say(cache.search.done and "no safe route in this layout" or string.format("searching cushions / combinations | %d tested",cache.search.completed))
        return
    end
    log(string.format("search finished %.2fs | %d fast / %d native",os.clock()-cache.started,cache.search.fastCount,cache.search.nativeCount))
    log(string.format("%s | target %d | power %.3f | predicted pots %d | %d variation checks",shot.kind,shot.id,shot.power,shot.own,shot.verified))
    if shot.own==0 then say("recovery contact — no pot predicted") end
    if mode=="legit" then
        say(string.format("aiming at %d | %.1fs",shot.id,aimTime))
        local started=os.clock()
        -- Rotate toward the selected line during the configured aiming time.
        local startAngle=math.atan2(shot.dir.Z,shot.dir.X)+.25
        while os.clock()-started<aimTime do
            if not valid() then hidePreview();return end
            local a=math.clamp((os.clock()-started)/aimTime,0,1)
            local angle=startAngle-.25*(a*a*(3-2*a))
            previewAim(frameData,snap,shot,Vector3.new(math.cos(angle),0,math.sin(angle)))
            Run.RenderStepped:Wait()
        end
    end
    if not valid() then hidePreview();return end
    previewAim(frameData,snap,shot,shot.dir)
    -- Same ordering as the client's own shot callback. Native RunShot owns the result.
    lastSubmission={table=t,turn=turnEnd}
    local success,err=pcall(function()
        RS.Modules.Events.RemoteEvent:FireServer("SnookerAimEnd",t)
        Blink.Snooker.Strike.Fire({Table=t,Power=shot.power,Heading=shot.dir})
        nativeShot(t,shot.power,shot.dir,true)
        pendingResult={table=t,snap=snap,expected=shot.pocketed or {},start=os.clock(),busy=false}
    end)
    hidePreview()
    if not success then
        stop();say("shot error: "..tostring(err));return
    end
    say("shot sent — waiting for the balls")
end
local function observeResult()
    local p=pendingResult
    if not p then return false end
    if not p.table.Parent then log("result unavailable: table removed");pendingResult=nil;return false end
    if simulations[p.table] or p.table:GetAttribute("SnookerBusy") then p.busy=true;p.settledAt=nil;return true end
    if not p.busy and os.clock()-p.start<2 then return true end
    p.settledAt=p.settledAt or os.clock()
    if os.clock()-p.settledAt<.05 then return true end
    local actual,expected,match={}, {},true
    local seen={}
    for _,b in ipairs(p.snap) do
        if not b.pocketed and b.model.Parent and b.model:GetAttribute("Pocketed")==true then
            actual[#actual+1]=b.id;seen[b.id]=true
            if not p.expected[b.id] then match=false end
        end
    end
    for id in pairs(p.expected) do expected[#expected+1]=id;if not seen[id] then match=false end end
    table.sort(actual);table.sort(expected)
    if not match and p.table:GetAttribute("ShooterId")==nil then
        log("result unavailable: round ended before confirmation")
        pendingResult=nil;return false
    end
    log(string.format("result | predicted [%s] / observed [%s] | %s",table.concat(expected,","),table.concat(actual,","),match and "matched" or "DIFFERENT"))
    pendingResult=nil
    return false
end
local failedState,failedTime
while alive do
    task.wait(mode=="instant" and .03 or .1)
    local resultPending=observeResult()
    if not enabled or resultPending then continue end
    local t,why=ownTable()
    local available,reason=canPlay(t)
    if not available then hidePreview();say(why or reason);continue end
    -- Recalculate when ball or turn state changes. Avoid constantly repeating an unsolved layout.
    local signature=tostring(t)..":"..tostring(t:GetAttribute("TurnEnds"))
    if failedState==signature and os.clock()-(failedTime or 0)<.15 then continue end
    local success,err=pcall(turn,t,epoch)
    if not success then
        hidePreview();say("planning error: "..tostring(err))
        failedState,failedTime=signature,os.clock()
    elseif not lastSubmission or lastSubmission.table~=t or lastSubmission.turn~=t:GetAttribute("TurnEnds") then
        failedState,failedTime=signature,os.clock()
    end
end
