-- Read-only cooking diagnostic. No remote replay, input hooks or automation.
local RS=game:GetService("ReplicatedStorage")
local Players=game:GetService("Players")
local HTTP=game:GetService("HttpService")
local UIS=game:GetService("UserInputService")
local env=type(getgenv)=="function" and getgenv() or _G
local old=env.__REF_COOK_PROTOCOL_CLOSE
if type(old)=="function" then pcall(old) end
local alive=true
local connections={}
local result={version="Cooking protocol 1",place=game.PlaceId,exported=os.date("!%Y-%m-%dT%H:%M:%SZ"),modules={},api={},kitchen={},errors={}}
local encoded
local output="True Ref/Logs/cooking-protocol.json"
local function make(class,props,parent)
    local obj=Instance.new(class)
    for key,value in pairs(props) do obj[key]=value end
    obj.Parent=parent;return obj
end
local gui=make("ScreenGui",{Name="RefCookingDiagnostic",ResetOnSpawn=false,DisplayOrder=100},Players.LocalPlayer:WaitForChild("PlayerGui"))
local frame=make("Frame",{Size=UDim2.fromOffset(340,152),Position=UDim2.new(.5,-170,.3,0),BackgroundColor3=Color3.fromRGB(19,19,21),BorderSizePixel=0},gui)
make("UICorner",{CornerRadius=UDim.new(0,10)},frame)
local title=make("TextLabel",{Size=UDim2.new(1,-70,0,38),Position=UDim2.fromOffset(14,0),BackgroundTransparency=1,Text="cooking diagnostic",Font=Enum.Font.GothamSemibold,TextSize=15,TextColor3=Color3.new(1,1,1),TextXAlignment=Enum.TextXAlignment.Left,Active=true},frame)
local status=make("TextLabel",{Size=UDim2.new(1,-28,0,57),Position=UDim2.fromOffset(14,40),BackgroundTransparency=1,Text="Reading the current game modules...",TextWrapped=true,Font=Enum.Font.Gotham,TextSize=12,TextColor3=Color3.fromRGB(184,184,190)},frame)
local function button(text,pos,size,callback)
    local b=make("TextButton",{Text=text,Position=pos,Size=size,BackgroundColor3=Color3.fromRGB(37,37,40),BorderSizePixel=0,Font=Enum.Font.Gotham,TextSize=13,TextColor3=Color3.new(1,1,1)},frame)
    make("UICorner",{CornerRadius=UDim.new(0,6)},b)
    connections[#connections+1]=b.Activated:Connect(callback)
    return b
end
local function close()
    if not alive then return end
    alive=false
    for _,c in ipairs(connections) do c:Disconnect() end
    gui:Destroy()
    if env.__REF_COOK_PROTOCOL_CLOSE==close then env.__REF_COOK_PROTOCOL_CLOSE=nil end
end
env.__REF_COOK_PROTOCOL_CLOSE=close
button("x",UDim2.new(1,-40,0,7),UDim2.fromOffset(28,26),close)
local clipboard=setclipboard or toclipboard
button("copy report",UDim2.new(0,14,1,-43),UDim2.new(1,-28,0,29),function()
    if not encoded then status.Text="Still reading modules. Please wait.";return end
    if type(clipboard)=="function" then
        local ok=pcall(clipboard,encoded)
        status.Text=ok and "Report copied." or "Copy failed. Use the saved JSON file."
    else status.Text="Clipboard unavailable. Use the saved JSON file." end
end)
local drag,start,position
connections[#connections+1]=title.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then drag=input;start=input.Position;position=frame.Position end
end)
connections[#connections+1]=UIS.InputChanged:Connect(function(input)
    if drag and (input==drag or input.UserInputType==Enum.UserInputType.MouseMovement) then
        local d=input.Position-start
        frame.Position=UDim2.new(position.X.Scale,position.X.Offset+d.X,position.Y.Scale,position.Y.Offset+d.Y)
    end
end)
connections[#connections+1]=UIS.InputEnded:Connect(function(input)if input==drag then drag=nil end end)
local function bounded(fn,seconds)
    local done,ok,value=false,false,nil
    task.spawn(function()ok,value=pcall(fn);done=true end)
    local deadline=os.clock()+seconds
    while alive and not done and os.clock()<deadline do task.wait(.05) end
    if not done then return false,"timeout" end
    return ok,value
end
local function selected(module)
    local path=module:GetFullName():lower()
    for _,word in ipairs({"overcook","cooking","kitchen","ingredient","storagelist","refrigerator"}) do
        if path:find(word,1,true) then return true end
    end
    return false
end
task.spawn(function()
    local ok,failure=pcall(function()
        local blink=RS:FindFirstChild("Blink")
        local client=blink and blink:FindFirstChild("Client")
        local candidates={}
        if client and client:IsA("ModuleScript") then candidates[#candidates+1]=client end
        for _,obj in ipairs(RS:GetDescendants()) do
            if obj:IsA("ModuleScript") and obj~=client and selected(obj) then candidates[#candidates+1]=obj end
        end
        local bytes=0
        for i,module in ipairs(candidates) do
            if not alive then return end
            if i>35 or bytes>5000000 then result.errors[#result.errors+1]="Source limit reached";break end
            status.Text=string.format("Reading module %d/%d\n%s",i,#candidates,module.Name)
            local entry={path=module:GetFullName()}
            if type(decompile)=="function" then
                local read,source=bounded(function()return decompile(module)end,10)
                if read and type(source)=="string" then
                    entry.source=source:sub(1,2000000);entry.truncated=#source>2000000;bytes+=#entry.source
                else entry.error=tostring(source) end
            else entry.error="decompile unavailable" end
            result.modules[#result.modules+1]=entry
        end
        if not alive then return end
        if client then
            local loaded,api=bounded(function()return require(client)end,5)
            if loaded and type(api)=="table" then
                local visited={}
                local function describe(value,path,depth)
                    if visited[value] or depth>5 or #result.api>=700 then return end
                    visited[value]=true
                    for key,item in pairs(value) do
                        if type(key)~="string" then continue end
                        local name=path.."."..key
                        if type(item)=="table" then describe(item,name,depth+1)
                        elseif type(item)=="function" then
                            local entry={path=name}
                            -- Metadata only. Never invoke Fire/Invoke or game actions.
                            for _,reader in pairs({global=getconstants,debug=debug and debug.getconstants}) do
                                if type(reader)=="function" then
                                    local good,constants=pcall(reader,item)
                                    if good and type(constants)=="table" and next(constants) then
                                        entry.constants={}
                                        for index,v in pairs(constants) do
                                            if type(v)=="string" or type(v)=="number" or type(v)=="boolean" then
                                                entry.constants[#entry.constants+1]={index=tostring(index),value=v}
                                            end
                                        end
                                        break
                                    end
                                end
                            end
                            result.api[#result.api+1]=entry
                        end
                    end
                end
                describe(api,"Blink.Client",0)
            else result.errors[#result.errors+1]="Blink API: "..tostring(api) end
        end
        local map=workspace:FindFirstChild("Map")
        local house=map and map:FindFirstChild("House")
        house=house and house:FindFirstChild("House")
        local kitchen=house and house:FindFirstChild("Chicken")
        if kitchen then
            for _,obj in ipairs(kitchen:GetDescendants()) do
                if #result.kitchen>=650 then break end
                if obj:IsA("Model") or obj:IsA("ProximityPrompt") then
                    local entry={path=obj:GetFullName(),class=obj.ClassName}
                    if obj:IsA("ProximityPrompt") then entry.action=obj.ActionText;entry.enabled=obj.Enabled end
                    result.kitchen[#result.kitchen+1]=entry
                end
            end
        else result.errors[#result.errors+1]="Kitchen not loaded" end
        if type(env.__REF_COOK_EXPORT)=="function" then
            local got,text=pcall(env.__REF_COOK_EXPORT)
            if got then result.cookingLog=text end
        end
    end)
    if not alive then return end
    if not ok then result.errors[#result.errors+1]=tostring(failure) end
    encoded=HTTP:JSONEncode(result)
    env.__REF_COOK_PROTOCOL_REPORT=encoded
    local saved,saveError=pcall(function()
        assert(type(writefile)=="function" and type(makefolder)=="function" and type(isfolder)=="function","File API unavailable")
        for _,folder in ipairs({"True Ref","True Ref/Logs"}) do if not isfolder(folder) then makefolder(folder) end end
        writefile(output,encoded)
    end)
    status.Text=saved and "Done. Saved in workspace/"..output or "Done. Copy the report below."
    print("[ref/cooking diagnostic] "..(saved and output or tostring(saveError)))
end)
