connect(title.InputBegan, function(i)
    if not drag and (
        i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch
    ) then
        drag = {
            input = i,
            start = i.Position,
            origin = position,
        }
    end
end)

connect(Input.InputChanged, function(i)
    if not drag then return end

    local touch = drag.input.UserInputType == Enum.UserInputType.Touch

    if (touch and i ~= drag.input)
        or (not touch and i.UserInputType ~= Enum.UserInputType.MouseMovement) then
        return
    end

    position = Vector2.new(
        drag.origin.X + i.Position.X - drag.start.X,
        drag.origin.Y + i.Position.Y - drag.start.Y
    )

    fit()
end)

connect(Input.InputEnded, function(i)
    if drag and (
        i == drag.input
        or (
            drag.input.UserInputType == Enum.UserInputType.MouseButton1
            and i.UserInputType == Enum.UserInputType.MouseButton1
        )
    ) then
        drag = nil
    end
end)

connect(Input.WindowFocusReleased, function()
    drag = nil
end)

