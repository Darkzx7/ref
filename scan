listen(copy.Activated, function()
    local export = monitor:Export()

    local clipboard = type(setclipboard) == "function" and setclipboard
        or (type(toclipboard) == "function" and toclipboard or nil)

    if clipboard and pcall(clipboard, export) then
        notify("Logs copied")
        return
    end

    manual.Text = export
    manual.Visible = true
    scroll.Visible = false

    manual:CaptureFocus()
    manual.SelectionStart = 1
    manual.CursorPosition = #export + 1

    notify("Clipboard unavailable · text selected for manual copy")
end)

listen(manual.FocusLost, function()
    manual.Visible = false
    scroll.Visible = true
end)

local lastRefresh = 0

listen(RunService.Heartbeat, function(delta)
    sampleTime += delta

    if sampleTime >= CONFIG.SampleInterval then
        sampleTime = 0

        if root and root.Parent then
            local current = root.Position

            if lastPosition
                and (current - lastPosition).Magnitude >= CONFIG.JumpDistance then
                monitor:Add(
                    "MOVE",
                    "Sudden displacement (cause unknown)",
                    lastPosition,
                    current,
                    (current - lastPosition).Magnitude
                )
            end

            lastPosition = current
        end
    end

    local now = os.clock()
    if now - lastRefresh < 0.25 then return end
    lastRefresh = now

    if not monitor.dirty and noticeUntil == 0 then return end

    local atBottom = scroll.CanvasPosition.Y + scroll.AbsoluteSize.Y
        >= scroll.AbsoluteCanvasSize.Y - 24

    logText.Text = table.concat(monitor:Entries(60), "\n")

    if atBottom then
        scroll.CanvasPosition = Vector2.new(
            0,
            math.max(0, logText.AbsoluteSize.Y + 16 - scroll.AbsoluteSize.Y)
        )
    end

    status.Text = now < noticeUntil and notice or string.format(
        "%s · %d stored · %d dropped\nOutgoing: %s · client-wide observations",
        monitor.paused and "Paused" or "Recording",
        monitor.count,
        monitor.dropped,
        monitor.outgoing
    )

    if now >= noticeUntil then noticeUntil = 0 end
    monitor.dirty = false
end)

listen(gui.Destroying, function()
    monitor.alive = false

    if bridge and bridge.sink == sink then
        bridge.sink = nil
    end

    disconnect(connections)
    disconnect(characterConnections)

    for _, list in pairs(watched) do
        disconnect(list)
    end

    if cameraConnection then cameraConnection:Disconnect() end
end)

bindCamera()

