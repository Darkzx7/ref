bind(startButton.Activated,function()
    if running then return end
    running=true; stop=false
    task.spawn(function()
        local ok,err=pcall(function()
            repeat runPizza(api); pause(1) until not loop
        end)
        running=false
        if not ok then note(tostring(err)) end
    end)
end)


bind(setFridgeButton.Activated,function()
    if running then note("Stop before setting the fridge spot.");return end
    local ok,err=pcall(function()
        setup()
        local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        assert(root,"Character unavailable")
        assert((root.Position-partOf(stations.fridge.anchor).Position).Magnitude<8,"Stand near the refrigerator first")
        fridgeCalibration=partOf(stations.cutting.anchor).CFrame:ToObjectSpace(root.CFrame)
        note("Fridge position saved for this session")
    end)
    if not ok then note(tostring(err)) end
end)
bind(testFridgeButton.Activated,function()
    if running then return end
    running=true;stop=false
    task.spawn(function()
        local ok,err=pcall(function()
            setup();approach(stations.fridge);inRange(stations.fridge)
            for _, name in ipairs({"Cabbage","Brown Mushroom","Tomato","Cheese","Pizza Dough"}) do
                assert(sourceItem(name,"Refrigerator"),"Missing model: "..name)
            end
            assert(sourceItem("Pepperoni","Freezer"),"Missing model: Pepperoni")
            note("Fridge position reached; all six ingredient models found. No items taken.")
        end)
        running=false
        if not ok then note(tostring(err)) end
    end)
end)
