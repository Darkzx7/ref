local drag, origin, initial
bind(title.InputBegan,function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
        drag,origin,initial=i,i.Position,frame.Position
    end
end)
bind(Input.InputChanged,function(i)
    if drag and (i==drag or (drag.UserInputType==Enum.UserInputType.MouseButton1
        and i.UserInputType==Enum.UserInputType.MouseMovement)) then
        local d=i.Position-origin
        frame.Position=UDim2.new(initial.X.Scale,initial.X.Offset+d.X,initial.Y.Scale,initial.Y.Offset+d.Y)
    end
end)
bind(Input.InputEnded,function(i) if i==drag then drag=nil end end)
local function note(text)
    history[#history+1]=os.date("%H:%M:%S").." "..text
    if #history>250 then table.remove(history,1) end
    if alive then status.Text=text end
end
local function check()
    if not alive or stop then error("Stopped. Check the stations before restarting.",0) end
    local h=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not h or h.Health<=0 then error("Character unavailable.",0) end
end
local function pause(seconds)
    local deadline=os.clock()+seconds
    repeat check(); task.wait(0.08) until os.clock()>=deadline
end
local function waitFor(fn,seconds,message)
    local deadline=os.clock()+seconds
    repeat
        check()
        local result=fn()
        if result then return result end
        task.wait(0.08)
    until os.clock()>=deadline
    if message then error(message,0) end
end
local function tool(name)
    for _, parent in pairs({character=player.Character,backpack=player:FindFirstChildOfClass("Backpack")}) do
        local t=parent:FindFirstChild(name)
        if t and t:IsA("Tool") then return t end
    end
end
local function inventory(stage)
    local items={}
    for key,parent in pairs({held=player.Character,bag=player:FindFirstChildOfClass("Backpack")}) do
        for _, item in ipairs(parent:GetChildren()) do
            if item:IsA("Tool") then items[#items+1]=key..":"..item.Name end
        end
    end
    note(stage.." | "..table.concat(items,", "))
end
local function requireItem(name,stage)
    local item=tool(name)
    if not item then
        inventory(stage)
        error("Item disappeared "..stage..": "..name,0)
    end
    return item
end
local function equip(name)
    local t=waitFor(function() return tool(name) end,6,"Missing item: "..name)
    -- Food is already equipped when collected. Re-equipping can unequip it first.
    if t.Parent==player.Character then return t end
    player.Character:FindFirstChildOfClass("Humanoid"):EquipTool(t)
    waitFor(function() return t.Parent==player.Character end,3,"Cannot equip: "..name)
    pause(0.2)
    return t
end
local function travel(pos,target)
    check()
    local root=player.Character:FindFirstChild("HumanoidRootPart")
    assert(root,"HumanoidRootPart missing")
    root.CFrame=CFrame.lookAt(pos,Vector3.new(target.X,pos.Y,target.Z))
    root.AssemblyLinearVelocity=Vector3.zero
    pause(1.25)
    assert((root.Position-pos).Magnitude<5,"Teleport was not accepted")
end
local function partOf(p)
    return p:FindFirstAncestorWhichIsA("BasePart")
end
local function prompt(scope,name)
    return scope:FindFirstChild(name,true)
end
local stations
local function stationPosition(s)
    if s.fridge then
        local base=partOf(stations.cutting.anchor)
        if fridgeCalibration then
            local cf=base.CFrame*fridgeCalibration
            return cf.Position,cf.Position+cf.LookVector
        end
        -- The refrigerator prompt belongs to a moving door. Use the fixed counter.
        return base.Position+Vector3.new(1.61,-0.64,-6.58),
            base.Position+Vector3.new(-0.24,-0.5,-5.17)
    end
    local p=partOf(s.anchor)
    assert(p,"Station position unavailable")
    return p.Position+s.offset,p.Position
end
local function approach(s)
    local destination,target=stationPosition(s)
    local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if root and (root.Position-destination).Magnitude<1.25 then pause(0.2);return end
    travel(destination,target)
end
local function setup()
    local map=workspace:FindFirstChild("Map")
    local house=map and map:FindFirstChild("House")
    house=house and house:FindFirstChild("House")
    local kitchen=house and house:FindFirstChild("Chicken")
    assert(kitchen,"Kitchen not loaded. Move near the kitchen first.")
    local function station(name,offset,anchorName)
        local scope=kitchen:FindFirstChild(name,true)
        assert(scope,"Missing station: "..name)
        local anchor=prompt(scope,anchorName or "AddIngredient")
        assert(anchor,"Missing station prompt: "..name)
        return {scope=scope,anchor=anchor,offset=offset}
    end
    local fridge=kitchen:FindFirstChild("Refrigerator")
    local fridgePrompt
    if fridge then
        for _, p in ipairs(fridge:GetDescendants()) do
            if p:IsA("ProximityPrompt") and p.ActionText=="Refrigerator" then fridgePrompt=p; break end
        end
    end
    assert(fridgePrompt,"Refrigerator position not found")
    stations={
        kitchen=kitchen,
        refrigerator=fridge,
        fridge={anchor=fridgePrompt,fridge=true},
        cutting=station("Cutting Table",Vector3.new(2.8,-0.64,-1.05)),
        rolling=station("RollingTable",Vector3.new(-0.87,-0.64,-2.87)),
        combine=station("Combine Edit Table",Vector3.new(-2.74,0.11,0.87)),
        oven=station("Cookware",Vector3.new(2.2,-0.35,-0.02),"OpenProcessorContainer"),
    }
    stations.oven.processor=stations.oven.scope:FindFirstChild("Stove")
    assert(stations.oven.processor,"Stove model missing")
end

-- Packet IDs and instance layouts come from the user's captured session.
-- The second byte of station packets is a Blink invocation identifier.
local env=type(getgenv)=="function" and getgenv() or _G
local transport=env.__PIZZA_REQUEST_IDS or {next=128}
env.__PIZZA_REQUEST_IDS=transport
local Remote=game:GetService("ReplicatedStorage"):WaitForChild("BLINK_RELIABLE_REMOTE",8)
assert(Remote and Remote:IsA("RemoteEvent"),"Kitchen remote missing")
local TIMING={cutting=3.2,rolling=4,combine=6.5,oven=15.5}
local function packet(opcode,requestId)
    local bytes=buffer.create(requestId~=nil and 2 or 1)
    buffer.writeu8(bytes,0,opcode)
    if requestId~=nil then buffer.writeu8(bytes,1,requestId) end
    return bytes
end
local function sendEvent(opcode,instances,label)
    check()
    note(label)
    Remote:FireServer(packet(opcode),instances)
end
local function request(opcode,instances,label)
    check()
    local id=transport.next
    transport.next=id>=255 and 128 or id+1
    note(string.format("%s [id %d]",label,id))
    Remote:FireServer(packet(opcode,id),instances)
end
local function inRange(s)
    local destination=stationPosition(s)
    local root=player.Character:FindFirstChild("HumanoidRootPart")
    assert(root and (root.Position-destination).Magnitude<5,"Station position not reached")
end
local function sourceItem(name,storage)
    local shelf=stations.refrigerator:FindFirstChild(storage=="Freezer" and "Into Freezer" or "Into Refrigerator")
    local item=shelf and shelf:FindFirstChild(name)
    return item and item:IsA("Model") and item
end
local function take(name,storage)
    approach(stations.fridge)
    inRange(stations.fridge)
    local source=waitFor(function() return sourceItem(name,storage) end,8,"Ingredient model missing: "..name)
    assert(not tool(name),"Already carrying "..name.."; clear the partial attempt first")
    sendEvent(0x71,{source},"Taking "..name)
    waitFor(function() return tool(name) end,8,"Pickup was not confirmed: "..name)
    equip(name)
    requireItem(name,"after pickup")
end
local function processor(s) return s.processor or s.scope end
local function put(s,name)
    equip(name)
    approach(s)
    inRange(s)
    local item=requireItem(name,"before adding")
    if not s.checked and s~=stations.oven then
        local processing=prompt(s.scope,"ProcessIngredients")
        local collect=prompt(s.scope,"CollectResult")
        assert(not (processing and processing.Enabled) and not (collect and collect.Enabled),
            "Station has leftover ingredients: "..s.scope.Name)
        s.checked=true
    end
    request(0x19,{processor(s),item},"Adding "..name)
    waitFor(function() return not tool(name) end,8,"Add was not confirmed: "..name)
    pause(0.35)
end
local function process(s,expected,kind)
    local collect=prompt(s.scope,"CollectResult")
    request(0x1a,{processor(s)},"Processing "..kind)
    -- Prompts can indicate completion even without opening any menu.
    -- The recorded timings are the fallback when the game hides local prompts.
    local started=os.clock()
    waitFor(function()
        return (collect and collect.Enabled) or os.clock()-started>=TIMING[kind]
    end,TIMING[kind]+2,"Processing timed out")
    request(0x1c,{processor(s)},"Collecting "..expected)
    waitFor(function() return tool(expected) or tool("Rotten Dish") end,10,"Collection not confirmed: "..expected)
    assert(not tool("Rotten Dish"),"Unexpected Rotten Dish. Stopped without discarding anything.")
    equip(expected)
    requireItem(expected,"after collection")
end
local api={}
function api.preflight()
    setup()
    for _, name in ipairs({"Rotten Dish","Cabbage","Brown Mushroom","Tomato","Cheese","Pepperoni","Pizza Dough",
        "Sliced Cabbage","Sliced Brown Mushroom","Sliced Tomato","Sliced Cheese","Sliced Pepperoni",
        "Rolled Pizza Dough","Pizza","Hot Pizza"}) do
        assert(not tool(name),"Clear the previous attempt before starting: "..name)
    end
    note("Ready. Event mode; keep other cooking scripts stopped.")
end
function api.prepare(raw,prepared,storage,station)
    take(raw,storage)
    put(stations[station],raw)
    process(stations[station],prepared,station)
    put(stations.combine,prepared)
end
function api.combine()
    process(stations.combine,"Pizza","combine")
end
function api.cook()
    put(stations.oven,"Pizza")
    request(0x1a,{processor(stations.oven)},"Starting oven")
    -- Both captured successful runs reached the ready phase at about 14 seconds.
    -- This remains a measured delay, not a decoded server readiness notification.
    local finish=os.clock()+TIMING.oven
    while os.clock()<finish do
        note("Cooking Pizza: "..math.ceil(finish-os.clock()).."s")
        pause(math.min(1,finish-os.clock()))
    end
    inRange(stations.oven)
    request(0x1b,{processor(stations.oven)},"Turning oven off")
    pause(0.4)
    request(0x1c,{processor(stations.oven)},"Collecting Hot Pizza")
    waitFor(function() return tool("Hot Pizza") or tool("Rotten Dish") end,10,"Hot Pizza collection not confirmed")
    assert(not tool("Rotten Dish"),"Oven produced Rotten Dish. Stopped.")
    equip("Hot Pizza")
    waitFor(function()
        local item=tool("Hot Pizza")
        return item and item.Parent==player.Character
    end,5,"Hot Pizza is not equipped")
    note("Hot Pizza equipped")
end
function api.sell()
    note("Moving to Merchant with Hot Pizza")
    equip("Hot Pizza")
    local npcs=workspace:FindFirstChild("NPCS")
    local merchant=npcs and npcs:FindFirstChild("Merchant")
    assert(merchant and merchant:IsA("Model"),"Merchant is not loaded")
    local pos=merchant:GetPivot().Position
    travel(pos+Vector3.new(1.59,2.8,-2.07),pos)
    requireItem("Hot Pizza","after moving to Merchant")
    local root=player.Character:FindFirstChild("HumanoidRootPart")
    assert(root and (root.Position-pos).Magnitude<=7,"Not close enough to Merchant")
    local remote=game:GetService("ReplicatedStorage"):FindFirstChild("BLINK_RELIABLE_REMOTE")
    assert(remote and remote:IsA("RemoteEvent"),"Sale remote unavailable")
    local packet=buffer.fromstring(string.char(0x1e,0x02,0x00,0x00,0x00))
    note("Sending sale packet once")
    remote:FireServer(packet,{})
    waitFor(function() return not tool("Hot Pizza") end,10,
        "Sale not confirmed: Hot Pizza is still in inventory. Packet was not repeated.")
    note("Hot Pizza removed after sale packet. Credit change not checked.")
end
-- ENGINE BEGIN
local function runPizza(actions)
    actions.preflight()
    actions.prepare("Cabbage","Sliced Cabbage","Refrigerator","cutting")
    actions.prepare("Brown Mushroom","Sliced Brown Mushroom","Refrigerator","cutting")
    actions.prepare("Tomato","Sliced Tomato","Refrigerator","cutting")
    actions.prepare("Cheese","Sliced Cheese","Refrigerator","cutting")
    actions.prepare("Pepperoni","Sliced Pepperoni","Freezer","cutting")
    actions.prepare("Pizza Dough","Rolled Pizza Dough","Refrigerator","rolling")
    actions.combine()
    actions.cook()
    actions.sell()
end
-- ENGINE END
