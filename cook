end)
bind(stopButton.Activated,function() stop=true; note("Stopping...") end)
bind(copyButton.Activated,function()
    local fn=type(setclipboard)=="function" and setclipboard or toclipboard
    if type(fn)=="function" then pcall(fn,table.concat(history,"\n")) end
end)
bind(startButton.Activated,function()
    if running then return end
    running=true; stop=false
    task.spawn(function()
        local ok,err=pcall(function()
            repeat runPizza(api); pause(1) until not loop
        end)
        running=false
        if not ok then note(tostring(err)) end
    end)
end)


bind(setFridgeButton.Activated,function()
    if running then note("Stop the test before setting the fridge spot.");return end
    local ok,err=pcall(function()
        setup()
        local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        assert(root,"Character unavailable")
        local door=partOf(stations.fridge.anchor)
        assert((root.Position-door.Position).Magnitude<8,"Stand next to the refrigerator first.")
        fridgeCalibration=partOf(stations.cutting.anchor).CFrame:ToObjectSpace(root.CFrame)
        note("Fridge spot saved for this session. Press Test fridge.")
    end)
    if not ok then note(tostring(err)) end
end)
bind(testFridgeButton.Activated,function()
    if running then return end
    running=true;stop=false
    task.spawn(function()
        local ok,err=pcall(function()
            setup()
            openStorage("Refrigerator")
            note("Refrigerator opened. No ingredients selected.")
        end)
        running=false
        if not ok then note(tostring(err)) end
    end)
end)
